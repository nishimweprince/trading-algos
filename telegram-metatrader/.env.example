# Telegram user account credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# Use either a session file or a string session. The login command writes the file.
TELEGRAM_SESSION_PATH=./state/telegram.session
TELEGRAM_SESSION_STRING=

# Source chat. Accepts @blacktrade, blacktrade, numeric IDs, or -100... channel IDs.
CHAT_ID=@blacktrade

# MetaTrader 5 terminal and account. Leave account values blank to use the terminal's active account.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000

# Trading safety. Orders are never sent unless LIVE_TRADING_ENABLED=true.
LIVE_TRADING_ENABLED=false
DEFAULT_VOLUME=0.01
MAX_DEVIATION_POINTS=20
ORDER_MAGIC=240710
SYMBOL_MAP_JSON={"GOLD":"XAUUSD","XAU":"XAUUSD","XAUUSD":"XAUUSD"}

# Polling
POLL_INTERVAL_SECONDS=5
POLL_MAX_MESSAGES=50

# Runtime
STATE_DIR=./state
LOGS_DIR=./logs
LOG_LEVEL=INFO
LOG_RAW_MESSAGES=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8091

