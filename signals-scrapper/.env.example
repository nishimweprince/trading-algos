# JSON array of sources. type is TRADING_CENTRAL or AUTOCHARTIST.
SOURCES='[
  {"type":"TRADING_CENTRAL","url":"https://secure.icmarkets.com/TradingCentral/TradingCentral"},
  {"type":"AUTOCHARTIST","url":"https://secure.icmarkets.com/AutoChartist/AutoChartist"}
]'

# How the bot reaches an already-authenticated browser
# PERSISTENT (default): Playwright opens Chrome with a saved profile under USER_DATA_DIR.
#   First run with HEADLESS=false, log into IC Markets once; later runs reuse the session.
# CDP: attach to Chrome started with --remote-debugging-port=9222 (set CDP_ENDPOINT).
BROWSER_MODE=PERSISTENT
USER_DATA_DIR=./.chrome-profile
CDP_ENDPOINT=http://127.0.0.1:9222

# Scheduling
CRON_EXPRESSION=*/15 * * * *

# Output
IDEAS_LOG_PATH=./data/ideas.jsonl
SCREENSHOT_DIR=./data/screenshots
SEEN_STATE_PATH=./data/seen.json

# Behavior
HEADLESS=false
NAV_TIMEOUT_MS=30000
# Wait after navigation before reading content (TC ideas load inside Recognia iframe)
CONTENT_WAIT_MS=10000
