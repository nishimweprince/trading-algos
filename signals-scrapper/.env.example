# JSON array of sources. type is TRADING_CENTRAL or AUTOCHARTIST.
# AUTOCHARTIST uses the IC Markets SSO SignIn endpoint, which opens/redirects to
# the standalone Autochartist web app (webapp.autochartist.com). The bot then
# clicks the "Our Favourites" tab, screenshots it, and sends it to OpenAI.
SOURCES='[
  {"type":"TRADING_CENTRAL","url":"https://secure.ic.com/TradingCentral/TradingCentral"},
  {"type":"AUTOCHARTIST","url":"https://secure.ic.com/AutoChartist/SignIn"}
]'

# Trading Central requires a dedicated CDP-enabled Chrome profile.
# Chrome 136+ also requires a non-default --user-data-dir.
BROWSER_MODE=CDP
USER_DATA_DIR=./.chrome-profile
CDP_ENDPOINT=http://127.0.0.1:9222
HOST_OS=AUTO
CDP_AUTO_START=true
CHROME_EXECUTABLE_PATH=
CDP_STARTUP_TIMEOUT_MS=20000

# OpenAI Responses API vision extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000

# Optional MT5 execution. This switch creates no backlog while false.
# The paired execution-service MT5 profile must separately have TRADING_ENABLED=true.
MT5_SIGNAL_TRADING_ENABLED=false
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=
MT5_SIGNAL_TIMEOUT_MS=70000
MT5_EXECUTION_MAX_ENTRIES=5000
MT5_SIGNAL_RULES='{
  "EUR/USD": { "symbol": "EURUSD", "volume": "0.10" },
  "AUD/JPY": { "symbol": "AUDJPY", "volume": "0.05" }
}'

# Scheduling
# Run screenshot/OpenAI signal extraction (example: once per hour).
SIGNAL_CRON_EXPRESSION=0 * * * *
# Reload authenticated source tabs only (example: every 5 minutes).
AUTH_REFRESH_CRON_EXPRESSION=*/5 * * * *

# Output
IDEAS_LOG_PATH=./data/ideas.jsonl
SCREENSHOT_DIR=./data/screenshots
SEEN_STATE_PATH=./data/seen.json
DEBUG_RUN_MAX_ENTRIES=100

# Behavior
HEADLESS=false
NAV_TIMEOUT_MS=30000
# Wait after navigation before reading content (TC ideas load inside Recognia iframe)
CONTENT_WAIT_MS=10000
