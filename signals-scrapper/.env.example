# JSON array of sources. type is TRADING_CENTRAL or AUTOCHARTIST.
# AUTOCHARTIST uses the IC Markets SSO SignIn endpoint, which opens/redirects to
# the standalone Autochartist web app (webapp.autochartist.com). The bot then
# clicks the "Our Favourites" tab, screenshots it, and sends it to OpenAI.
SOURCES='[
  {"type":"TRADING_CENTRAL","url":"https://secure.ic.com/TradingCentral/TradingCentral"},
  {"type":"AUTOCHARTIST","url":"https://secure.ic.com/AutoChartist/SignIn"}
]'

# Browser: the scraper attaches over CDP to Chrome and reuses its tabs.
BROWSER_MODE=CDP
# MAIN (default) attaches to your everyday, already-open Chrome window — it
# never launches a new Chrome. One-time setup per Chrome session: open
# chrome://inspect/#remote-debugging, enable "Allow remote debugging for this
# browser instance", then click "Allow" when Chrome asks (once per scraper
# start/reconnect, not per cron tick). Requires Chrome 144+.
# DEDICATED uses a separate profile (USER_DATA_DIR) on CDP_ENDPOINT and may
# auto-start it (CDP_AUTO_START); use it for fully unattended hosts.
CHROME_PROFILE=MAIN
# Optional absolute path to the main Chrome user-data dir. Empty = OS default
# (Windows: %LOCALAPPDATA%\Google\Chrome\User Data,
#  macOS: ~/Library/Application Support/Google/Chrome).
CHROME_USER_DATA_DIR=
# How long to wait for the Chrome "Allow" prompt to be approved.
CDP_CONNECT_TIMEOUT_MS=120000
HOST_OS=AUTO
# DEDICATED-only settings:
USER_DATA_DIR=./.chrome-profile
CDP_ENDPOINT=http://127.0.0.1:9222
CDP_AUTO_START=true
CHROME_EXECUTABLE_PATH=
CDP_STARTUP_TIMEOUT_MS=20000

# OpenAI Responses API vision extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000

# Optional MT5 execution via services/execution-service (MT5 compat API).
# This switch creates no backlog while false.
# Target profile on the same Windows host:
#   --profile hfm  -> http://127.0.0.1:8000
#   --profile ftmo -> http://127.0.0.1:8001
# The execution-service profile must also have:
#   API_KEY equal to MT5_SIGNAL_API_KEY below (>= 16 chars),
#   ALLOWED_SIGNAL_SOURCES containing trading_central,autochartist,
#   TRADING_ENABLED=true (plus LIVE_TRADING_ENABLED=true on a live account).
MT5_SIGNAL_TRADING_ENABLED=false
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=
MT5_SIGNAL_TIMEOUT_MS=70000
MT5_EXECUTION_MAX_ENTRIES=5000
# Instrument (as extracted, e.g. "XAU/USD") -> broker symbol + volume.
# "symbol" must be an mt5_symbol from that profile's SYMBOLS_FILE
# (symbols.hfm.json: XAUUSDb, symbols.ftmo.json: XAUUSD); anything else is
# rejected with symbol_not_allowed. Volume must not exceed MAXIMUM_VOLUME.
MT5_SIGNAL_RULES='{
  "XAU/USD": { "symbol": "XAUUSDb", "volume": "0.01" }
}'

# Scheduling
# Run screenshot/OpenAI signal extraction (example: once per hour).
SIGNAL_CRON_EXPRESSION=0 * * * *
# Reload authenticated source tabs only (example: every 5 minutes).
AUTH_REFRESH_CRON_EXPRESSION=*/5 * * * *

# Output
IDEAS_LOG_PATH=./data/ideas.jsonl
SCREENSHOT_DIR=./data/screenshots
SEEN_STATE_PATH=./data/seen.json
DEBUG_RUN_MAX_ENTRIES=100
SEEN_MAX_ENTRIES=5000

# Behavior
HEADLESS=false
NAV_TIMEOUT_MS=30000
# Wait after navigation before reading content (TC ideas load inside Recognia iframe)
CONTENT_WAIT_MS=10000
