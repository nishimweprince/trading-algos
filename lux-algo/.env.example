# --- Market-data endpoint (polled for 1-minute candles) ---
# Defaults target mt5-trader's GET /v1/market-data/candles (same host/port as
# MT5_SIGNAL_API_URL below). Point elsewhere if you use a different feed.
DATA_API_URL=http://127.0.0.1:8000/v1/market-data/candles
# Same value as mt5-trader's API_KEY (mt5-trader's /v1/market-data/candles requires it).
DATA_API_KEY=replace-with-mt5-trader-API_KEY
QUOTE=XAUUSD
# How many 1-minute candles to request per poll. Must comfortably exceed warmup:
# roughly 150 target-timeframe bars, i.e. ~150 * TARGET_TF_MINUTES 1-minute candles.
DATA_LOOKBACK=600
# Query-parameter names your endpoint expects (defaults shown).
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10

# Poll cadence. Keep well under 60s so signals can fire mid-candle.
POLL_INTERVAL_SECONDS=15

# --- Timeframe / aggregation ---
# The strategy timeframe. 1-minute candles are aggregated into this. e.g. 3 = 3-minute.
TARGET_TF_MINUTES=3
# Shift bucket boundaries off the raw UTC-epoch grid if the feed's session requires it.
BUCKET_OFFSET_MINUTES=0

# --- Strategy (LuxAlgo Supertrend entry; defaults match file.txt) ---
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
# Take-profit distance as a multiple of the stop distance (entry -> supertrend line).
# Ignored when USE_HARD_TARGETS=true.
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
# Fixed pip SL/TP distances instead of supertrend / risk-reward. These are sent to
# mt5-trader as distances and resolved against the actual fill price, so the realised
# stop is exactly STOP_LOSS_PIPS regardless of spread or how far price moved since the
# candle close this service evaluated on.
USE_HARD_TARGETS=true
STOP_LOSS_PIPS=25
TAKE_PROFIT_PIPS=40

# Price movement of one pip, in quote units. SET THIS EXPLICITLY.
#
# Reference measurement (XAUUSD short, taken off the chart):
#   4046.607 -> 4042.579  =  4.028 price move  =  40.28 pips
# That calibrates PIP_SIZE=0.10, the value set below. Size your STOP_LOSS_PIPS and
# TAKE_PROFIT_PIPS against it: on this scale a ~4 dollar gold move is ~40 pips, so
# 1 pip = $0.10 and 10 pips = $1.00 of gold.
#
#   PIP_SIZE=0.10  ->  25 pips = $2.50, 40 pips = $4.00   <- calibrated above
#   PIP_SIZE=0.01  ->  25 pips = $0.25, 40 pips = $0.40   (that same move reads 402.8 pips)
#   EURUSD: PIP_SIZE=0.0001 -> 25 pips = 0.0025
#
# Gold has no agreed pip convention, which is why this is configuration and not derived.
# To re-calibrate on a different instrument or platform, measure a known move on the
# chart and divide: PIP_SIZE = price_move / reported_pips.
#
# Calibrating on TradingView while trading the MT5 feed is fine: PIP_SIZE is a unit
# conversion, and both quote XAUUSD in USD per ounce, so "1 pip = $0.10 of gold" holds on
# either. What does NOT carry across feeds is a price *level* — the two will not print
# the same bid at the same instant. That is precisely why hard targets are sent as
# distances and resolved against the MT5 fill.
#
# If unset, it falls back to the legacy 10^-(PRICE_DIGITS-1) derivation, which silently
# rescales your stop 10x if the broker quotes the same instrument to a different number
# of decimals. On a 3-decimal gold feed that fallback yields 0.01, not the 0.10 measured
# above — a 10x tighter stop. Do not rely on it.
PIP_SIZE=0.10

# Decimal places to round prices to. Quote precision only — no longer affects pip size.
# This must match the feed you TRADE on, not the chart you calibrated PIP_SIZE from: the
# 4046.607 reference above is a TradingView quote, and your broker may quote XAUUSD to a
# different number of decimals. Read it off the terminal you actually execute against:
#   GET /v1/market-data/tick?quote=XAUUSD   (mt5-trader, X-API-Key required)
# and count the decimals in bid/ask. XAUUSD is commonly 2, sometimes 3; EURUSD is 5.
PRICE_DIGITS=3

# --- Confluence: overlays that must agree with the Supertrend trigger direction ---
# unanimous = every enabled overlay must confirm; threshold = at least N confirm;
# off = no gating (reproduces the raw Pine Supertrend buy/sell exactly).
CONFLUENCE_MODE=unanimous
# Used only when CONFLUENCE_MODE=threshold. 0 means "all enabled overlays".
CONFLUENCE_THRESHOLD=0
# Overlays shown by default in file.txt -> enabled here by default.
USE_RANGE_FILTER=true
USE_SUPERICHI=true
USE_TBO=true
USE_SMART_TRAIL=true
# Ported but off by default (mirrors file.txt inputs / avoids over-restriction).
USE_HA_BIAS=false
USE_MACD_COLOR=false
USE_PSAR=false
# Counter-trend vetoes: an opposing marker blocks the entry (does not open trades).
VETO_TP_POINTS=false
VETO_REVERSALS=false

# --- Order fields sent to mt5-trader ---
# MUST be an exact symbol from mt5-trader's ALLOWED_SYMBOLS.
MT5_SYMBOL=XAUUSD
# Fixed lot size. SL/TP distances are independent of volume; volume sets the cash risk.
# Cash risk = STOP_LOSS_PIPS × PIP_SIZE × VOLUME × contract_size, where contract_size is
# the broker's own figure (100 oz for standard XAUUSD, but verify — micro gold contracts
# and some DMT5 symbols differ). With PIP_SIZE=0.10 and a 100 oz contract:
#   0.10 lot, 25 pips -> 25 × 0.10 × 0.10 × 100 = $25.00
# This is a guide, not something the service enforces: nothing here reads the broker's
# contract size, so confirm the figure against your symbol's specification.
VOLUME=0.10
DEVIATION_POINTS=
IGNORE_SIGNAL_AGE=true

# --- mt5-trader connection ---
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=replace-with-mt5-trader-API_KEY
MT5_TIMEOUT_SECONDS=10
# Gate submissions on GET /health/ready before POSTing.
REQUIRE_READY=true

# --- Runtime ---
LOG_LEVEL=INFO
LOGS_DIR=logs
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
