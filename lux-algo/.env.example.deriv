# Deriv DMT5 / synthetic indices profile — copy to .env.deriv and run with --profile deriv
# Start the paired mt5-trader instance first:
#   Copy-Item .env.example.deriv .env.deriv   (in mt5-trader)  ->  mt5-signal-service --profile deriv
#   Copy-Item .env.example.deriv .env.deriv   (here)           ->  lux-algo --profile deriv

# --- Market-data endpoint (polled for 1-minute candles) ---
DATA_API_URL=http://127.0.0.1:8001/v1/market-data/candles
DATA_API_KEY=replace-with-mt5-trader-API_KEY

# Single instrument (legacy). Omit when using SYMBOLS_FILE below.
QUOTE=Volatility 75 Index
DATA_LOOKBACK=600
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10

POLL_INTERVAL_SECONDS=15

# --- Timeframe / aggregation ---
TARGET_TF_MINUTES=3
BUCKET_OFFSET_MINUTES=0

# --- Strategy (LuxAlgo Supertrend entry; defaults match file.txt) ---
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
USE_HARD_TARGETS=true
# Tune to the synthetic's volatility after calibration (see PIP_SIZE below).
STOP_LOSS_PIPS=50
TAKE_PROFIT_PIPS=80

# Price movement of one pip, in quote units. SET THIS EXPLICITLY.
#
# Synthetic indices have broker-specific point sizes — there is no universal pip
# convention. Measure a known move on your DMT5 chart and divide:
#   PIP_SIZE = price_move / reported_pips
#
# Read PRICE_DIGITS from the feed you trade on:
#   GET /v1/market-data/tick?quote=Volatility%2075%20Index   (mt5-trader, X-API-Key required)
#
# Other DMT5 symbols (must match mt5-trader ALLOWED_SYMBOLS exactly):
#   Volatility 10 Index, Volatility 25 Index, Volatility 50 Index,
#   Volatility 75 Index, Volatility 100 Index,
#   Crash 300 Index, Crash 500 Index, Crash 1000 Index,
#   Boom 300 Index, Boom 500 Index, Boom 1000 Index,
#   Step Index, Step Index 200, Step Index 500
PIP_SIZE=0.01

PRICE_DIGITS=2

# --- Confluence ---
CONFLUENCE_MODE=unanimous
CONFLUENCE_THRESHOLD=0
USE_RANGE_FILTER=true
USE_SUPERICHI=true
USE_TBO=true
USE_SMART_TRAIL=true
USE_HA_BIAS=false
USE_MACD_COLOR=false
USE_PSAR=false
VETO_TP_POINTS=false
VETO_REVERSALS=false

# --- Order fields sent to mt5-trader ---
# Single instrument (legacy). Omit when using SYMBOLS_FILE below.
MT5_SYMBOL=Volatility 75 Index
VOLUME=0.10
# Wider than forex majors; mt5-trader deriv defaults are 50/100.
DEVIATION_POINTS=50
IGNORE_SIGNAL_AGE=true

# --- mt5-trader connection (port must match mt5-trader deriv PORT) ---
# mt5-trader deriv MAXIMUM_VOLUME must be >= largest lot in SYMBOLS_FILE (100.00 for
# symbols.deriv.json); forex's 1.00 default rejects calibrated synthetic volumes.
MT5_SIGNAL_API_URL=http://127.0.0.1:8001
MT5_SIGNAL_API_KEY=replace-with-mt5-trader-API_KEY
MT5_TIMEOUT_SECONDS=10
REQUIRE_READY=true

# --- Runtime ---
LOG_LEVEL=INFO
LOGS_DIR=logs/deriv
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# --- Multi-instrument (optional) ---
# When set, QUOTE and MT5_SYMBOL above are ignored. Copy symbols.example.deriv.json
# to symbols.deriv.json and edit per-instrument overrides.
# SYMBOLS_FILE=symbols.deriv.json
