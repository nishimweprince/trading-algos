# Copy to .env (same folder as straddle.py) and fill in.
# Distances are in POINTS. On 5-digit FX (EURUSD 1.08123): 10 points = 1 pip.
# On gold (XAUUSD 2650.12): 1 point = 0.01, so 100 points = $1.00.

# ---------------- Timing ----------------
# Release time in GMT/UTC. Also accepts "13:30" or "13:30:00" (= today, GMT).
EXECUTION_TIME_GMT=2026-11-10 13:30:00
# Pending orders are placed this many seconds before the release.
ARM_SECONDS_BEFORE=15
# Unfilled pending orders are cancelled this many seconds after the release.
PENDING_EXPIRY_SECONDS=120

# ---------------- Instrument ----------------
SYMBOL=EURUSD
# Distance from current price to each stop entry (100 = 10 pips on EURUSD).
ENTRY_DISTANCE_POINTS=100
STOP_LOSS_POINTS=150
# 0 = no fixed take-profit (let the trailing stop take profit).
TAKE_PROFIT_POINTS=0
# Orders are not placed while the spread is wider than this (0 = no filter).
MAX_SPREAD_POINTS=30
DEVIATION_POINTS=30

# ---------------- Sizing ----------------
# Lots from risk: RISK_PERCENT of balance lost if SL is hit with SIZING_SLIPPAGE_POINTS extra slippage.
RISK_PERCENT=1.0
# Set > 0 to use a fixed lot size instead of risk sizing.
LOT_SIZE=0
# Raw/razor commission per 1.0 lot, round turn, in account currency (included in sizing).
COMMISSION_PER_LOT=7.0
SIZING_SLIPPAGE_POINTS=50
# Upper cap: one order may use at most this % of free margin.
MAX_MARGIN_PCT=50

# ---------------- Exits ----------------
# Cancel the other account's pending order once one leg fills.
OCO=true
# Move SL to entry + offset once the trade is this many points in profit (0 = off).
BREAKEVEN_TRIGGER_POINTS=60
BREAKEVEN_OFFSET_POINTS=10
# Trailing stop on the filled leg.
TRAIL_ENABLED=true
TRAIL_START_POINTS=100
TRAIL_DISTANCE_POINTS=80
TRAIL_STEP_POINTS=10
# Close the position after this many seconds no matter what (0 = off).
MAX_HOLD_SECONDS=900
# On Ctrl+C: pending orders are always cancelled; true also closes open positions.
CLOSE_ON_EXIT=false

# ---------------- Safety ----------------
# true = order_check only, nothing is sent. Set to false to trade.
DRY_RUN=true
MAGIC=20261110
ORDER_COMMENT=news-straddle
POLL_MS=100
LOG_DIR=logs

# ---------------- Account 1 (buy leg) ----------------
ACC1_ENABLED=true
ACC1_LOGIN=12345678
ACC1_PASSWORD=change-me
ACC1_SERVER=Broker-Server
# Each account needs its OWN terminal install.
ACC1_TERMINAL_PATH=C:\MT5_Account1\terminal64.exe
ACC1_PORTABLE=false
# BUY, SELL or BOTH (both = full straddle inside this one account)
ACC1_SIDE=BUY
# Optional per-account overrides (e.g. broker symbol suffix):
# ACC1_SYMBOL=EURUSD.r
# ACC1_RISK_PERCENT=1.0
# ACC1_LOT_SIZE=0
# ACC1_COMMISSION_PER_LOT=7.0

# ---------------- Account 2 (sell leg) ----------------
ACC2_ENABLED=true
ACC2_LOGIN=87654321
ACC2_PASSWORD=change-me
ACC2_SERVER=Broker-Server
ACC2_TERMINAL_PATH=C:\MT5_Account2\terminal64.exe
ACC2_PORTABLE=false
ACC2_SIDE=SELL
# ACC2_SYMBOL=EURUSD.r
