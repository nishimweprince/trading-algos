# poly-kalshi: Kalshi-signal / Polymarket-leg recorder, engine and paper venue.
# Install: see infra/systemd/README.md (poly-kalshi section). Edit User= and the
# paths if the checkout or the profile differ. Secrets stay in the service's
# .env.<profile> (chmod 600) and the Kalshi PEM, never in this file.
[Unit]
Description=poly-kalshi-service (15-min convergence, paper, profile dev)
# A failed start or crash sends a Telegram alert (rate-limited, see pk-unit-alert@.service).
OnFailure=pk-unit-alert@%n.service
Wants=network-online.target
After=network-online.target time-sync.target notification-service.service
# Never record to the OS disk because the data disk failed to mount.
RequiresMountsFor=/data

[Service]
Type=simple
User=pk
Group=pk
WorkingDirectory=/home/pk/trading-algos/services/poly-kalshi-service
ExecStart=/home/pk/trading-algos/.venv/bin/poly-kalshi-service --profile dev
Restart=always
RestartSec=5
# Time for the recorder to flush and write its manifests on stop.
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
