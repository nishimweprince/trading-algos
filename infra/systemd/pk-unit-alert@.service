# Sends a Telegram alert (via notification-service, else poly-kalshi's own bot)
# when the unit named by the instance fails. Units opt in with:
#   OnFailure=pk-unit-alert@%n.service
# A small static binary with no configuration of its own beyond the env file,
# so it works even when the failing service's configuration is what broke.
[Unit]
Description=Alert that %i failed

[Service]
Type=oneshot
User=pk
Group=pk
SupplementaryGroups=systemd-journal
StateDirectory=pk-unit-alert
ExecStart=/home/pk/trading-algos/services/poly-kalshi-service/target/release/pk-unit-alert %i --env-file /home/pk/trading-algos/services/poly-kalshi-service/.env.dev
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
