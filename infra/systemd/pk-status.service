# Read-only poly-kalshi status page on 127.0.0.1:8051. Publish only through an
# authenticating proxy (the ofi Cloudflare Tunnel + Access recipe); never open
# 8051 in the cloud firewall.
[Unit]
Description=pk-status (read-only poly-kalshi status page, profile dev)
OnFailure=pk-unit-alert@%n.service
Wants=network-online.target poly-kalshi-service.service
After=network-online.target poly-kalshi-service.service

[Service]
Type=simple
User=pk
Group=pk
WorkingDirectory=/home/pk/trading-algos/services/poly-kalshi-service
ExecStart=/home/pk/trading-algos/services/poly-kalshi-service/target/release/pk-status --profile dev
Restart=always
RestartSec=5
# Never compete with the trader for CPU or memory: it reads the trader once per
# 5 s and the journal from disk, whatever the number of viewers. 1G: at 256M
# it was OOM-killed (2026-10-12) once the journal held days of shadow records,
# and at 512M it OOM-looped on every start (2026-10-23/24, ~430M steady, a day
# of live + leadlag records in the journal).
Nice=10
CPUWeight=20
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
