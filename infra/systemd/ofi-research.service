# One-shot: the Stage 2 research pipeline (replay -> train -> select -> gates),
# run next to the recorder and the demo bridge without starving them: lowest CPU
# and IO priority, and a memory ceiling so the OOM killer picks this job, never
# the recorder. Tune the ceiling and the arguments in a drop-in after resizing:
#   sudo systemctl edit ofi-research   ([Service] MemoryMax=, Environment="OFI_RESEARCH_ARGS=...")
# Start by hand: sudo systemctl start ofi-research; follow: journalctl -fu ofi-research
[Unit]
Description=ofi-scalper research pipeline (low priority)
After=ofi-scalper-service.service
RequiresMountsFor=/data

[Service]
Type=oneshot
User=ofi
Group=ofi
WorkingDirectory=/home/ofi/trading-algos/services/ofi-scalper-service
Environment=OFI_RESEARCH_DIR=/data/ofi/research
# Sized for 4 vCPU / 16 GB (D4ads_v6): 2 jobs (~2 GB each) leave 2 cores and ~5 GB
# for the recorder, the demo bridge and execution-service. Keep --jobs <= vCPUs - 2.
Environment="OFI_RESEARCH_ARGS=--shallow --jobs 2 --row-stride 3"
ExecStart=/bin/sh -c 'exec /home/ofi/trading-algos/.venv/bin/python -m research.pipeline --profile dev $OFI_RESEARCH_ARGS'
Nice=19
CPUWeight=10
IOSchedulingClass=idle
MemoryHigh=9G
MemoryMax=10G
OOMScoreAdjust=900
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
