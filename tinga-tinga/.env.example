# Prices come from market-data-service's crypto market, never from Binance
# directly. Use the API_KEY of the running market-data-service.
MARKET_DATA_URL=http://127.0.0.1:8020
MARKET_DATA_API_KEY=replace-with-market-data-service-api-key
MARKET_DATA_MARKET=crypto

# Strategy Configuration Overrides
STRATEGY_SYMBOL=BTCUSDT
STRATEGY_TIMEFRAME=1h
STRATEGY_RSI_PERIOD=14

# Risk Management
INITIAL_BALANCE=10000
MAX_RISK_PER_TRADE=2.0
MAX_DRAWDOWN=20.0

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/tinga-tinga.log