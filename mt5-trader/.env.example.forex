# Forex / majors profile — copy to .env (default) or .env.forex (--profile forex)
# MetaTrader 5 terminal and the single server-owned account
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-account-password
MT5_SERVER=Broker-Demo
MT5_TIMEOUT_MS=60000

# API authentication (use a high-entropy value of at least 16 characters)
API_KEY=replace-with-a-long-random-secret

# Bind address. Give each instance its own port when running multiple profiles.
HOST=127.0.0.1
PORT=8000

# Exact, case-sensitive broker symbols and service guardrails
ALLOWED_SYMBOLS=EURUSD,GBPUSD
# Comma-separated signal provider slugs accepted on POST /v1/signals.
# Add new strategies here without a code change (lowercase letters, digits, underscores).
ALLOWED_SIGNAL_SOURCES=trading_central,autochartist,lux_algo,ipda
# Must be >= the largest client volume (ipda forex BTCUSD is 0.05 on a 10K-class account).
MAXIMUM_VOLUME=1.00
MAGIC_NUMBER=234000
DEFAULT_DEVIATION_POINTS=10
MAXIMUM_DEVIATION_POINTS=20
SIGNAL_MAX_AGE_SECONDS=60
FUTURE_TOLERANCE_SECONDS=5

# Cap on requested candle lookback for GET /v1/market-data/candles
MAX_CANDLES_LOOKBACK=5000

LOG_LEVEL=INFO

# SQLite ledger. Use an absolute writable path in production.
DATABASE_PATH=C:\mt5-signal-service\data\signals.sqlite3

# Fail-safe default. Set true only after demo-account verification.
TRADING_ENABLED=false

# --- notification-service (optional) ---
# Recipients are configured on notification-service; these flags control whether
# this profile sends alerts after each signal reaches a terminal execution state
# and after failed inbound requests (validation errors, non-auth service errors).
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
# Comma-separated: TELEGRAM, EMAIL, SMS, WHATSAPP
NOTIFICATION_CHANNELS=TELEGRAM

# Append-only signal outcome log (separate from DATABASE_PATH SQLite ledger).
SIGNALS_LOG_PATH=logs/signals.jsonl
