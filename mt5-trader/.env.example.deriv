# Deriv DMT5 / synthetic indices profile — copy to .env.deriv and run with --profile deriv
# MetaTrader 5 terminal and the single server-owned account
MT5_TERMINAL_PATH=C:\Program Files\Deriv MT5 Terminal\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-account-password
MT5_SERVER=Deriv-Demo
MT5_TIMEOUT_MS=60000

# API authentication (use a high-entropy value of at least 16 characters)
API_KEY=replace-with-a-long-random-secret

# Bind address. Must differ from other profiles on the same host.
HOST=127.0.0.1
PORT=8001

# Exact DMT5 Market Watch names — remove symbols your account does not expose.
# Major synthetic indices (one per line for reference):
#   Volatility 10 Index
#   Volatility 25 Index
#   Volatility 50 Index
#   Volatility 75 Index
#   Volatility 100 Index
#   Crash 300 Index
#   Crash 500 Index
#   Crash 1000 Index
#   Boom 300 Index
#   Boom 500 Index
#   Boom 1000 Index
#   Step Index
#   Step Index 200
#   Step Index 500
ALLOWED_SYMBOLS=Volatility 10 Index,Volatility 25 Index,Volatility 50 Index,Volatility 75 Index,Volatility 100 Index,Crash 300 Index,Crash 500 Index,Crash 1000 Index,Boom 300 Index,Boom 500 Index,Boom 1000 Index,Step Index,Step Index 200,Step Index 500
# Deriv synthetics use contract size 1; calibrated lots in symbols.deriv.json reach 100.
# Must be >= the largest manifest volume (and <= each symbol's broker volume_max).
MAXIMUM_VOLUME=100.00
MAGIC_NUMBER=234001
DEFAULT_DEVIATION_POINTS=50
MAXIMUM_DEVIATION_POINTS=100
SIGNAL_MAX_AGE_SECONDS=60
FUTURE_TOLERANCE_SECONDS=5

# Cap on requested candle lookback for GET /v1/market-data/candles
MAX_CANDLES_LOOKBACK=5000

LOG_LEVEL=INFO

# SQLite ledger. Use a path distinct from the forex profile.
DATABASE_PATH=C:\mt5-signal-service\data\signals-deriv.sqlite3

# Fail-safe default. Set true only after demo-account verification.
TRADING_ENABLED=false

# --- notification-service (optional) ---
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
SIGNALS_LOG_PATH=logs/signals.jsonl
