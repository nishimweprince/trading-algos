# Copy to server/.env. Never commit the private file.
LOOKUP_CAPITAL_ENVIRONMENT=demo
LOOKUP_CAPITAL_API_KEY=
LOOKUP_CAPITAL_IDENTIFIER=
LOOKUP_CAPITAL_API_PASSWORD=
# JSON map from canonical application symbols to Capital instrument EPICs.
# Capital Demo exposes the XAUUSD/Gold market as GOLD.
LOOKUP_CAPITAL_EPICS='{"XAUUSD":"GOLD"}'
LOOKUP_CAPITAL_PRICE_SIDE=bid
LOOKUP_CAPITAL_OVERLAP_BARS=3
LOOKUP_CAPITAL_SETTLEMENT_SECONDS=90
LOOKUP_CAPITAL_POLL_SECONDS=60

# Best-effort forward meta-event notifications. The standalone notification
# service owns recipients and provider credentials.
LOOKUP_META_EVENT_NOTIFICATIONS_ENABLED=false
LOOKUP_NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
LOOKUP_NOTIFICATION_API_KEY=
LOOKUP_NOTIFICATION_CHANNELS=TELEGRAM,EMAIL
LOOKUP_NOTIFICATION_TIMEOUT_SECONDS=5
LOOKUP_NOTIFICATION_RETRY_MINUTES=10
LOOKUP_NOTIFICATION_MAX_ATTEMPTS=5
LOOKUP_NOTIFICATION_MAX_AGE_HOURS=24
LOOKUP_META_SHADOW_STALE_SECONDS=300

# Pluggable market execution. Keep this false throughout initial/demo rollout.
# Enabling the app flag is not sufficient by itself: the selected execution
# service must be trading-ready and the active immutable artifact/pointer must
# both explicitly carry orders_enabled=true.
LOOKUP_MARKET_EXECUTION_ENABLED=false
# mt5 or ctrader. Required with a bare LOOKUP_EXECUTION_URL.
LOOKUP_EXECUTION_PROVIDER=mt5
# A base URL or the provider's full endpoint (/v1/signals or /v1/orders).
LOOKUP_EXECUTION_URL=http://127.0.0.1:8000
LOOKUP_EXECUTION_API_KEY=
# Instead of LOOKUP_EXECUTION_PROVIDER + LOOKUP_EXECUTION_URL, set exactly one
# provider-specific URL. Do not configure common and provider-specific URLs together.
LOOKUP_MT5_TRADER_URL=
LOOKUP_CTRADER_MARKETS_URL=
LOOKUP_EXECUTION_VOLUME_LOTS=0.01
# Required only for cTrader. One logical order targets one configured account.
LOOKUP_EXECUTION_CTRADER_ACCOUNT=demo
# Add this slug to MT5 ALLOWED_SIGNAL_SOURCES or cTrader ALLOWED_ORDER_SOURCES.
LOOKUP_EXECUTION_SOURCE=lookup_trader
# Optional canonical lookup-trader symbol -> broker symbol map.
LOOKUP_EXECUTION_SYMBOL_MAP='{"XAUUSD":"XAUUSD"}'
LOOKUP_EXECUTION_TIMEOUT_SECONDS=5
# Provider trading-readiness heartbeat; defaults to five minutes.
LOOKUP_EXECUTION_HEARTBEAT_INTERVAL_SECONDS=300
# Never turn a recovery/catch-up event into a delayed market order.
LOOKUP_EXECUTION_MAX_EVENT_AGE_SECONDS=300
