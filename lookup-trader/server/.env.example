# Copy to server/.env. Never commit the private file.
LOOKUP_CAPITAL_ENVIRONMENT=demo
LOOKUP_CAPITAL_API_KEY=
LOOKUP_CAPITAL_IDENTIFIER=
LOOKUP_CAPITAL_API_PASSWORD=
# JSON map from canonical application symbols to Capital instrument EPICs.
# Capital Demo exposes the XAUUSD/Gold market as GOLD.
LOOKUP_CAPITAL_EPICS='{"XAUUSD":"GOLD"}'
LOOKUP_CAPITAL_PRICE_SIDE=bid
LOOKUP_CAPITAL_OVERLAP_BARS=3
LOOKUP_CAPITAL_SETTLEMENT_SECONDS=90
LOOKUP_CAPITAL_POLL_SECONDS=60

# Best-effort forward meta-event notifications. The standalone notification
# service owns recipients and provider credentials.
LOOKUP_META_EVENT_NOTIFICATIONS_ENABLED=false
LOOKUP_NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
LOOKUP_NOTIFICATION_API_KEY=
LOOKUP_NOTIFICATION_CHANNELS=TELEGRAM,EMAIL
LOOKUP_NOTIFICATION_TIMEOUT_SECONDS=5
