[Unit]
Description=pump-desk live migration racer
After=network-online.target chrony.service
Wants=network-online.target
# A crash loop must not hammer the chain: give up after 5 restarts in 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/build/pump-desk --config @ROOT@/pump-desk.toml
# Hot threads pin themselves to cpus 1-3 (threads.*_cpu). Isolate those cores and their
# hyperthread siblings so aux, the writer, ssh, cloudflared, and pump-desk-status stay
# on the remaining physical core (cpus 0 and 4 on c7i, where N and N+4 are siblings):
#   isolcpus=1-3,5-7 nohz_full=1-3,5-7 rcu_nocbs=1-3,5-7
LimitMEMLOCK=infinity
LimitNOFILE=65536
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
