# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_NAME=oanda-trading-server

# Internal API security
INTERNAL_API_KEY=replace-with-a-long-random-value

# OANDA
OANDA_ENV=practice
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
LIVE_TRADING_ENABLED=false
OANDA_ACCOUNT_ALIAS=primary

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oanda_trading

# Redis
REDIS_URL=redis://localhost:6379

# Trading controls
TRADING_ENABLED=true
GLOBAL_KILL_SWITCH=false

# Risk limits
MAX_RISK_PER_TRADE_PERCENT=0.50
MAX_DAILY_LOSS_PERCENT=2.00
MAX_TOTAL_OPEN_RISK_PERCENT=2.00
MAX_OPEN_TRADES=5
MAX_OPEN_TRADES_PER_INSTRUMENT=1
MAX_SPREAD_PIPS=3
MAX_SIGNAL_AGE_SECONDS=30
MAX_PRICE_AGE_SECONDS=5
MAX_ORDER_UNITS=100000
MIN_STOP_DISTANCE_PIPS=5
DEFAULT_RISK_REWARD_RATIO=2

# Execution
ORDER_TIMEOUT_MS=10000
REST_REQUEST_TIMEOUT_MS=10000
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500

# Synchronization
ACCOUNT_SYNC_INTERVAL_SECONDS=15
TRANSACTION_SYNC_INTERVAL_SECONDS=5

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
