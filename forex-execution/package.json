{
  "name": "forex-execution",
  "version": "1.0.0",
  "description": "Internal OANDA REST-v20 execution service built with Fastify and TypeScript.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:oanda-practice": "vitest run src/tests/integration/oanda-practice",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/helmet": "latest",
    "@fastify/rate-limit": "latest",
    "@fastify/sensible": "latest",
    "@prisma/client": "^6.19.3",
    "axios": "latest",
    "decimal.js": "latest",
    "fastify": "latest",
    "ioredis": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "undici": "latest",
    "uuid": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prisma": "^6.19.3",
    "testcontainers": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
