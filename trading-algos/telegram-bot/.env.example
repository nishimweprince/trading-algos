# ── Telegram (MTProto, user account) ───────────────────────────────────────
# From https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone in E.164. Used only by scripts/login.ts on first login.
TELEGRAM_PHONE_NUMBER=
# Path to the file holding the persisted GramJS session string.
# Created by scripts/login.ts. Treated as a secret, chmod 600.
TELEGRAM_SESSION_PATH=./state/session.txt

# ── Channels & polling ─────────────────────────────────────────────────────
# Comma separated list of public channel usernames, with or without @.
TELEGRAM_CHANNELS=@xauusdsignals,@goldcalls
# Poll cadence in seconds. Default 60s.
POLL_INTERVAL_SECONDS=60
# Per tick fetch limit. Safety cap so a flood of new messages cannot blow up memory.
POLL_MAX_MESSAGES_PER_CHANNEL=50

# ── State & logging ────────────────────────────────────────────────────────
STATE_DIR=./state
LOGS_DIR=./logs
LOG_LEVEL=info
# When true, every polled message is appended to logs/raw.jsonl.
# Useful when tuning the parser, off by default in production.
LOG_RAW_MESSAGES=false

# ── Pindo SMS ──────────────────────────────────────────────────────────────
PINDO_API_URL=https://api.pindo.io/v1/sms/
PINDO_TOKEN=
# Short alphanumeric brand (carrier limits ~11 chars in some regions).
PINDO_SENDER_ID=YourCompany

# ── Notification routing ───────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=true
# Comma separated E.164 numbers, e.g. +250788000000,+447700900000
NOTIFICATION_NUMBERS=

# ── HTTP server ────────────────────────────────────────────────────────────
HTTP_PORT=8081
HTTP_HOST=127.0.0.1
