# ── Capital.com (broker + market data) ─────────────────────────────────────
CAPITAL_API_KEY=replace_me
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_PASSWORD=replace_me
CAPITAL_ENVIRONMENT=demo

# ── Strategy ───────────────────────────────────────────────────────────────
SYMBOLS=EUR_USD,GBP_USD,USD_JPY
HTF_TIMEFRAMES=4H,1H
LTF_TIMEFRAMES=15M,5M
PAPER_MODE=true
RISK_PER_TRADE_PCT=0.5
BACKFILL_CANDLES=500

# ── FU indicator (defaults match the Pine script) ──────────────────────────
FU_USE_DOJI_FILTER=false
FU_USE_MA_FILTER=false
FU_SMA_LENGTH=9
FU_DOJI_BODY_RATIO=0.3

# ── FVG ────────────────────────────────────────────────────────────────────
FVG_THRESHOLD_PCT=0.0
FVG_AUTO_THRESHOLD=false
FVG_MTF=

# ── SMC structure / zones ──────────────────────────────────────────────────
SMC_STRUCTURE_TYPE=Choch without IDM
SMC_POI_TYPE=---
SMC_MERGE_RATIO=0.0
SMC_MAX_BAR_HISTORY=2000

# ── Master Pattern ─────────────────────────────────────────────────────────
MP_INDI_TYPE=1
MP_MAX_BARS=500

# ── Pivot swing ────────────────────────────────────────────────────────────
SWING_SIZE_L=15
SWING_SIZE_R=10
SWING_HIDE_FILLED=false
SWING_EXTEND_TIL_FILLED=true

# ── Event log ──────────────────────────────────────────────────────────────
INDICATOR_EVENT_LOG_PATH=./logs/indicator_events.jsonl

# ── Operational ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./fu_strategy.db
SIGNAL_LOG_PATH=./logs/signals.jsonl
NOTIFICATIONS_LOG_PATH=./logs/notifications.jsonl

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# From App Dashboard → WhatsApp → API Setup. Token and phone-number-id are required;
# the rest enable webhook verification, signed delivery events, and templated sends.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Leave WHATSAPP_TEMPLATE_NAME empty to send free-form text (only works inside
# the recipient's 24h conversation window). Set it to use an approved template
# for unsolicited signal notifications.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ── Notification routing ───────────────────────────────────────────────────
# Comma-separated E.164 numbers that receive every generated signal.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_NUMBERS=
