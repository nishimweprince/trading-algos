# ── Service ──────────────────────────────────────────────────────────────────
PORT=3010
DATABASE_URL=file:./data/notifications.db
NOTIFICATIONS_ENABLED=true
# When set, all /notifications routes require Authorization: Bearer <key> or X-API-Key
NOTIFICATION_API_KEY=

# ── Recipients (comma-separated) ─────────────────────────────────────────────
NOTIFICATION_PHONES=
NOTIFICATION_EMAILS=
NOTIFICATION_TELEGRAM_CHAT_IDS=

# ── Telegram ─────────────────────────────────────────────────────────────────
TG_BOT_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Notifications <onboarding@resend.dev>

# ── SMS (Pindo) ──────────────────────────────────────────────────────────────
PINDO_API_URL=https://api.pindo.io/v1/sms/
PINDO_TOKEN=
PINDO_SENDER_ID=Notifications

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
