# hlarb configuration. Copy to C:\hlarb\hlarb.env (outside the repo), fill in, and load it
# before starting hlarb (RUNBOOK.md). Values shown are the built-in defaults unless marked.

# ---- accounts (required for check/live)
# Master Hyperliquid address: fills, positions and margin are keyed by it.
HLA_HL_ACCOUNT=
# File holding the API/agent wallet private key (approve it at app.hyperliquid.xyz/API).
# hlarb refuses the master key and any key that is not an approved agent of HLA_HL_ACCOUNT.
HLA_AGENT_KEY_FILE=C:\hlarb\secrets\agent.key
# MT5 logins hlarb may hedge on (comma list). Any other logged-in account halts quoting.
HLA_MT5_LOGINS=

# ---- pairs: HLcoin=MT5SYMBOL[*ratio], where hl_price ~= ratio * mt5_price.
# Symbol names are broker-specific (e.g. "USDJPY.r", "US500.cash"): copy them from Market Watch.
# Startup refuses a pair whose prices differ by more than HLA_MAX_BASIS_PPM.
HLA_PAIRS=xyz:JPY=USDJPY,xyz:EUR=EURUSD,xyz:SILVER=XAGUSD,xyz:SP500=US500,xyz:XYZ100=NAS100,xyz:CL=USOIL,BTC=BTCUSD,ETH=ETHUSD

# ---- files
HLA_BRIDGE_NAME=Local\hla_bridge_v1
HLA_KILL_FILE=C:\hlarb\hlarb.kill
HLA_JOURNAL=C:\hlarb\journal\hlarb-%Y%m%dT%H%M%SZ.jsonl
HLA_STATUS_FILE=C:\hlarb\hlarb-status.json

# ---- quoting (ppm = 1e-6; 100 ppm = 1 bp)
HLA_QUOTE_LOTS=1               # MT5 lot steps per quote (0.01 lot = about $1k on FX)
HLA_MAX_INVENTORY_LOTS=2       # max HL position per pair, in MT5 lot steps
HLA_EDGE_PPM=100               # passive target beyond cost (fees + MT5 half-spread + adverse)
HLA_MIN_EDGE_PPM=10            # joining the HL touch never quotes inside cost + this, skew included
HLA_ADVERSE_PPM=100            # buffer for the ~200 ms HL inclusion delay
HLA_MT5_COMMISSION_PPM=35      # per hedge side ($3.50/lot on $100k)
HLA_SKEW_PPM=50                # fair shift per lot step of inventory
HLA_HL_MAKER_PPM=-1            # -1: userFees maker rate, x2 on HIP-3, /10 in growth mode
HLA_REQUOTE_PPM=10             # move a resting quote when its target moves this far (or 1 tick)
HLA_MIN_REQUOTE_MS=250
HLA_BASIS_TAU_S=1800           # EWMA of HL mid - ratio*MT5 mid
HLA_BASIS_WARMUP_S=300
HLA_MAX_BASIS_PPM=20000
HLA_MAX_FAIR_GAP_PPM=3000      # HL mid this far from fair: dislocation or bad data, stop quoting
HLA_MAX_MARK_ORACLE_PPM=5000
HLA_MAX_MT5_SPREAD_PPM=1000

# ---- staleness
HLA_MT5_TICK_STALE_MS=30000
HLA_MT5_HEARTBEAT_STALE_MS=1000
HLA_HL_STALE_MS=5000
HLA_AUX_STALE_MS=30000
HLA_ROLLOVER_UTC=20:55-21:10,21:55-22:10   # broker rollover (5 pm New York, both DST states)

# ---- hedging and risk
HLA_HEDGE_TIMEOUT_MS=1500
HLA_HEDGE_DEVIATION_POINTS=30
HLA_MT5_ORDER_MAX_AGE_MS=2000  # the DLL drops older hedge orders unexecuted
HLA_FLATTEN_SLIPPAGE_PPM=5000  # emergency IOC limit on the unhedged HL residual
HLA_MAX_DAILY_LOSS_USD=50      # HL + MT5 equity since 00:00 UTC; trips the kill file
HLA_MAX_GROSS_NOTIONAL_USD=5000
HLA_HL_MIN_MARGIN_USD=100      # per HIP-3 dex; keep well below the deposit or the first loss halts
HLA_MT5_MIN_MARGIN_USD=100     # same: a floor, not the account size
HLA_MARGIN_PARK_S=600          # an "Insufficient margin" reject parks that pair this long
HLA_HL_LEVERAGE=3
HLA_DEADMAN_S=60               # scheduleCancel horizon, refreshed while the engine is alive
HLA_EXPIRES_AFTER_MS=0         # >0 adds expiresAfter to every HL action
HLA_MIN_REQUEST_BUDGET=500     # HL address request budget floor
HLA_ADOPT_POSITIONS=0          # 1: start with unhedged positions and let the hedger square them

# ---- threads (-1 = unpinned). c7i.2xlarge: leave 0-1 to Windows, 2-3 to the MT5 services.
HLA_DECISION_CORE=4
HLA_GATEWAY_CORE=5
HLA_FEED_CORE=6
