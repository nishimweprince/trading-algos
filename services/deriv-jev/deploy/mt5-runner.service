[Unit]
Description=deriv-jev MT5 runner: 70%+ win-rate DSI group on Deriv MT5 (mode in .env.mt5)
After=mt5.service network-online.target
Wants=mt5.service

[Service]
WorkingDirectory=/opt/trading-algos/services/deriv-jev
ExecStart=/opt/trading-algos/services/deriv-jev/.venv/bin/python -u mt5_runner.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
