[Unit]
Description=Deriv Trek spike-flip fade: prospective paper test on recorded Deriv MT5 ticks (no orders sent)
After=mt5.service
Wants=mt5.service
[Service]
WorkingDirectory=/opt/trading-algos/services/deriv-jev
ExecStart=/opt/trading-algos/services/deriv-jev/.venv/bin/python -u trek_paper.py
Restart=always
RestartSec=15
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
