# Copy to .env and fill in. Never commit .env.
# cTrader Open API (market data only; the service never refreshes the token)
CTRADER_HOST=demo.ctraderapi.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# TypeSafe System One (Jev)
JEV_API_KEY=
# shadow = simulate fills, send no orders (the only supported mode)
ORDER_MODE=shadow
# UI: no auth unless UI_AUTH=on
UI_AUTH=off
UI_USER=
UI_PASS=
