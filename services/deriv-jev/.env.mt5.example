# MT5 runner for the 70%+ win-rate DSI group. Copy to .env.mt5.
# shadow = build + order_check every order, track virtual positions, send nothing (default)
# live   = send real orders. Switch this yourself.
MT5_MODE=shadow
# % of current equity risked per trade (compounding)
RISK_PCT=5
# skip a trade if the minimum lot would risk more than this % of equity
MAX_RISK_PCT=7.5
# extra margin over the broker's minimum stop distance, in %
STOP_BUFFER_PCT=20
# shadow mode: virtual starting balance (compounds with shadow P&L)
SHADOW_EQUITY=100
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=18812
