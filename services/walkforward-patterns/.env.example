# walkforward-patterns on the jito FRA host. Copy to .env (chmod 600). Never commit .env.
# Read by the service from its working directory (services/walkforward-patterns).
WFP_HUB_URL=http://127.0.0.1:8010
# the execution hub's API_KEY (services/execution-service/.env.production on the host)
WFP_HUB_API_KEY=
# hub alias of the FTMO $100k cTrader demo (hedging)
WFP_ACCOUNT=ftmo_wf_demo
# read-only status page on 127.0.0.1 (ssh -L 8083:127.0.0.1:8083)
WFP_STATUS_PORT=8083
WFP_WARMUP_DAYS=175
WFP_DRY_RUN=false
# FTMO limits are RECORD ONLY (owner, 2026-11-17): breaches are logged and notified, never acted on.
WFP_INITIAL_BALANCE=100000
WFP_DAILY_LOSS_PCT=5
WFP_MAX_LOSS_PCT=10
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
