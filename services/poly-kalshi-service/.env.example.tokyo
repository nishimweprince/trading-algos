# Copy to .env.tokyo, fill secrets locally, then chmod 0600 .env.tokyo.
API_KEY=replace-with-at-least-16-random-characters
LOG_LEVEL=INFO
KALSHI_API_KEY_ID=replace-with-read-only-kalshi-key-id
KALSHI_PRIVATE_KEY_PATH=/home/pk/secrets/kalshi-read-only.pem

# Predict.fun: shadow is the safe default. The API key is also required for
# public market-data WebSocket access. Keep the Privy and account values in
# this 0600 file only.
PK_PRED_ENABLED=yes
PK_PRED_PORT=8056
PK_PRED_MODE=shadow
PK_PRED_MAKER_ENABLED=yes
PK_PRED_TAKER_ENABLED=no
PREDICT_API_KEY=
PREDICT_PRIVY_PRIVATE_KEY=
PREDICT_ACCOUNT_ADDRESS=
PREDICT_BNB_RPC_URL=
# 56 = BNB mainnet (required for live), 97 = BNB testnet (shadow/protocol tests).
PREDICT_CHAIN_ID=56
PK_PRED_ASSETS=BTC,ETH
PK_PRED_FRESHNESS_MS=2000
PK_PRED_BASIS_BUFFER=0.02
PK_PRED_QUOTE_TTL_S=20
PK_PRED_HALF_SPREAD=0.03
PK_PRED_REQUOTE_CENTS=0.01
PK_PRED_MIN_REQUOTE_MS=500
PK_PRED_REFRESH_MS=5000
PK_PRED_MIN_TAKER_EDGE=0.08
PK_PRED_TAKER_SLIPPAGE=0.01
PK_PRED_MAX_ORDER_USD=10
PK_PRED_MAX_OPEN_USD=50
PK_PRED_DAILY_LOSS_USD=25
PK_PRED_MAX_ACTIVE_MARKETS=4
PK_PRED_MAX_OPEN_ORDERS=16
PK_PRED_AUTO_REDEEM=no
PK_PRED_AUTO_MERGE=no

# Hyperliquid HIP-4. HL_AGENT_PRIVATE_KEY is a dedicated registered API
# wallet, never the master-account key.
PK_HIP4_ENABLED=yes
PK_HIP4_PORT=8057
PK_HIP4_MODE=shadow
PK_HIP4_MAKER_ENABLED=yes
PK_HIP4_TAKER_ENABLED=no
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
HL_API_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws
PK_HIP4_MATCH_ALLOWLIST=config/hip4-allowlist.json
PK_HIP4_FRESHNESS_MS=2000
PK_HIP4_ALO_BATCH_MS=100
PK_HIP4_IOC_BATCH_MS=10
PK_HIP4_HALF_SPREAD=0.03
PK_HIP4_MIN_TAKER_EDGE=0.08
PK_HIP4_TAKER_SLIPPAGE=0.01
PK_HIP4_MAX_ORDER_USD=10
PK_HIP4_MAX_OPEN_USD=50
PK_HIP4_DAILY_LOSS_USD=25
PK_HIP4_MAX_ACTIVE_MARKETS=4
PK_HIP4_MAX_OPEN_ORDERS=16

# Set only after the promotion evidence is reviewed. Live has no capital
# defaults and refuses startup unless all risk values above are explicit.
PK_PRED_LIVE_CONFIRM=no
PK_PRED_MAKER_LIVE_CONFIRM=no
PK_PRED_TAKER_LIVE_CONFIRM=no
PK_HIP4_LIVE_CONFIRM=no
PK_HIP4_MAKER_LIVE_CONFIRM=no
PK_HIP4_TAKER_LIVE_CONFIRM=no

# Optional status host on this same Tokyo machine.
PK_STATUS_HOME=predict
