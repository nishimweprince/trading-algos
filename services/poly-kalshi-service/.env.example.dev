# poly-kalshi-service, profile "dev". Copy to .env.dev (chmod 600) and fill in.
# PK_EXECUTION_MODE=paper simulates entries; nothing can place a real order
# (live is refused at startup until the paper gates pass).
#
# London VM checklist (not settings, but the service assumes them):
#   - Polymarket's CLOB is in AWS eu-west-2 (London); Kalshi is in us-east-1.
#   - The UK is "close-only" on Polymarket: fine for recording and paper, but
#     this host can never place a real order. Phase 3 needs another host.
#   - Recordings are heavy: Polymarket alone sent ~270 frames/s for one BTC
#     window (2026-10-06). Budget several GB/day compressed for 5 assets, on
#     a data disk mounted at /data, owned by the service user.
#   - Clock sync on (chrony): every decision is timed by the local clock.
#   - HOST stays 127.0.0.1; reach the API over SSH (ssh -L 8050:127.0.0.1:8050 vm).

# --- service ---------------------------------------------------------------
# openssl rand -hex 24
API_KEY=replace-with-a-long-random-key
HOST=127.0.0.1
PORT=8050
LOG_LEVEL=INFO
PK_HOST_TAG=london
# Mac: PK_HOST_TAG=mac
PK_EXECUTION_MODE=paper
PK_ASSETS=BTC,ETH,SOL,XRP,BNB

# --- strategy (manual §3, deployed set 2026-09-13) ---------------------------
PK_GAP_THRESHOLD=0.20
PK_MAX_ENTRY_PX=0.60
PK_NOTIONAL_USD=50
PK_ENTRY_EARLY_S=20
PK_ENTRY_LATE_S=60

# --- paper venue ---------------------------------------------------------------
# The order meets the book this long after the decision (decision -> sign ->
# POST -> match). Measure it once Phase 3 exists; 150 ms is a guess.
PK_PAPER_LATENCY_MS=150
PK_PAPER_START_CASH_USD=1000

# --- hard risk limits (required) ----------------------------------------------
# 5 assets x one $50 entry per 15-min window, held to settlement: at most
# ~$250 open at once in steady state.
PK_MAX_OPEN_NOTIONAL_USD=500
PK_DAILY_LOSS_LIMIT_USD=250

# --- results epoch -----------------------------------------------------------------
# Results (page, read-out, export) are read per epoch, and every journal record
# carries it with the git build. Bump it when a fix invalidates earlier paper
# results: the ledger is archived and starts again from PK_PAPER_START_CASH_USD.
# Records written before epochs existed (the ghost-level period) are excluded.
PK_RESULTS_EPOCH=1

# --- websockets --------------------------------------------------------------------
# Frames buffered per socket before the client stops reading. Polymarket drops a
# reader that falls behind (1013 "slow consumer"); ~1 KB a frame.
PK_WS_MAX_QUEUE=32768

# --- recording -------------------------------------------------------------------
PK_RECORD_ENABLED=true
# VM: PK_RECORD_DIR=/data/pk/raw/dev
PK_MIN_FREE_DISK_GB=5

# --- Kalshi (signal only; the WS needs an authenticated connection) --------------
KALSHI_API_KEY_ID=replace-with-the-kalshi-key-id
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/poly-kalshi.pem
KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# --- Polymarket (public market data) ----------------------------------------------
POLY_GAMMA_URL=https://gamma-api.polymarket.com
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- status page (pk-status) ---------------------------------------------------
PK_STATUS_HOST=127.0.0.1
PK_STATUS_PORT=8051

# --- notifications (alerts via notification-service) ------------------------------
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM

# --- inbound Telegram commands (/kill, /status): a bot of its own -----------------
PK_TELEGRAM_BOT_TOKEN=
PK_TELEGRAM_ADMIN_USER_IDS=
