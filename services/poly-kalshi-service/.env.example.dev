# poly-kalshi-service, profile "dev". Copy to .env.dev (chmod 600) and fill in.
# PK_EXECUTION_MODE=paper simulates entries. live places real orders, and is
# refused at startup without PK_LIVE_CONFIRM=yes, POLY_PRIVATE_KEY, a wallet
# the service can redeem from and POLYGON_RPC_URL (see "live orders" below).
#
# --- live orders (PK_EXECUTION_MODE=live) ------------------------------------------
# Only after the paper gates pass, on a host allowed to trade (Dublin; never UK,
# US, DE or FR). Entries are FAK buys at the limit. Winnings are redeemed:
#   - EOA (POLY_SIGNATURE_TYPE=0): by the EOA itself, so it needs a little POL
#     and its own pUSD/CTF approvals.
#   - deposit wallet (POLY_SIGNATURE_TYPE=3, POLY_FUNDER; what polymarket.com
#     creates for a new account, funded at its deposit address): through
#     Polymarket's relayer, which pays the gas. Needs POLY_RELAYER_API_KEY.
# Proxy and Safe wallets (1, 2) are refused. Bump PK_RESULTS_EPOCH for a fresh
# live ledger. chmod 600 this file.
PK_LIVE_CONFIRM=no
POLYGON_RPC_URL=
# The collateral to redeem against; blank = the exchange's own (pUSD).
POLY_REDEEM_COLLATERAL=
# Deposit wallet only: polymarket.com > Settings > API Keys > Relayer API Keys.
POLY_RELAYER_API_KEY=
# The address that owns that key; blank = the POLY_PRIVATE_KEY address.
POLY_RELAYER_API_KEY_ADDRESS=
#
# Dublin VM checklist (the paper host, and the planned live host):
#   - Polymarket's CLOB is in AWS eu-west-2 (London); Kalshi is in us-east-1.
#     Dublin is the closest location allowed to trade on Polymarket: measured
#     feed latency ~10 ms Polymarket, ~47 ms Kalshi (2026-10-06).
#   - Recordings are heavy: ~8M lines an hour for 8 assets. The observer writes
#     hourly zstd files (pk_<YYYYMMDD>_<HH>_<session>.zst and a .zst.json
#     manifest), smaller than the old gzip tape. Budget ~10 GB/day on a data
#     disk mounted at /data, owned by the service user.
#   - Clock sync on (chrony): every decision is timed by the local clock.
#   - HOST stays 127.0.0.1; reach the API over SSH (ssh -L 8050:127.0.0.1:8050 vm).
#
# London (recording only): the UK is close-only on Polymarket, so a London host
# can record and replay but never trade. Set PK_HOST_TAG=london there; replays of
# London tapes are re-timed to Dublin with `pk replay run --shift-ms`.

# --- service ---------------------------------------------------------------
# openssl rand -hex 24
API_KEY=replace-with-a-long-random-key
HOST=127.0.0.1
PORT=8050
LOG_LEVEL=INFO
PK_HOST_TAG=dublin
# London (recording only): PK_HOST_TAG=london · Mac: PK_HOST_TAG=mac
PK_EXECUTION_MODE=paper
PK_ASSETS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE,ZEC

# --- strategy (0.15 from epoch 5, 2026-10-07; 0.10 in epochs 3-4) ---
PK_GAP_THRESHOLD=0.20
PK_MAX_ENTRY_PX=0.60
# Order size as a percent of the balance (paper: ledger cash; live: the wallet's
# pUSD), held in memory and recomputed only when nothing is open or in flight,
# so wins compound. 0 = the static PK_NOTIONAL_USD. Changes sizes: bump the epoch.
PK_ORDER_SIZE_PCT=5
PK_NOTIONAL_USD=50
# Fixed shares per entry (epoch 13: 10). Overrides the two sizes above, so the
# 5-share venue minimum never refuses the dearer entries. Must be >= 5 and
# fit PK_MAX_OPEN_NOTIONAL_USD at PK_MAX_ENTRY_PX.
# PK_ORDER_SHARES=10
PK_ENTRY_EARLY_S=20
PK_ENTRY_LATE_S=60
# The latency review's guards on the live rule (unset = off): skip an entry
# when the Polymarket legs' last frame is older than this, or their spread is
# wider than this.
# PK_MAX_POLY_LAG_MS=250
# PK_MAX_POLY_SPREAD=0.01
# Epoch 13's tradable-edge gates (unset = off). Enter only on a tight Kalshi
# book (the exit needs <= 0.02 too), a tight Polymarket book, Kalshi's price of
# the side at least PK_MIN_EDGE over the ask, and the ask at or above the floor.
# A gate that fails does not consume the window.
# PK_MAX_KALSHI_SPREAD=0.02
# PK_MIN_EDGE=0.10
# PK_MIN_ENTRY_PX=0.20
# Epoch 14: what both taker fees must leave per share, buying at the order's
# price and selling at Kalshi's price of the side (where the active exit sells).
# It caps the limit below touch + PK_LIMIT_OFFSET when the edge is thin, and an
# ask above that cap is no entry (the window stays open).
# PK_MIN_NET_EDGE=0.03
# A Polymarket book older than this at a decision is journalled with its cause
# (feed silence, reconnect, frame lag) as an age_outlier record.
PK_AGE_OUTLIER_MS=500
# No entry on a book that may be frozen (10-22 05:04Z: six entries on books
# 69-98 s old). Blocked, not consumed: the window can still trade once fresh.
# - the whole Polymarket feed silent this long, or resumed/reconnected less than
#   this long ago (ms; normal gaps >1.5 s ~10/h, >3 s never; 0 = off);
PK_MAX_POLY_SILENCE_MS=2000
# - one asset's own socket silent this long (ms; its p99.9 gap is 0.1-1.1 s; 0 = off).
PK_MAX_ASSET_SILENCE_MS=5000
# A Polymarket socket that delivers no data this long is reconnected (s; 0 = off).
PK_POLY_SILENCE_RECONNECT_S=20

# --- paper venue ---------------------------------------------------------------
# The order meets the book this long after the decision (decision -> sign ->
# POST -> match). This is only the seed: with the order path on (probe or live),
# the latency in force is the p50 of the last PK_LATENCY_WINDOW measured
# decision -> acknowledgement round trips once there are PK_LATENCY_MIN_SAMPLES,
# kept in memory and written to the tape as `latency` lines when it moves.
# Measured from live FAK entries only (filled or killed): post-only probes skip
# the venue's taker hold and read ~50 ms where a taker takes ~250 ms.
PK_PAPER_LATENCY_MS=250
PK_LATENCY_WINDOW=50
PK_LATENCY_MIN_SAMPLES=10
# Probes between decisions keep the estimate fresh (seconds; 0 = off).
PK_PROBE_CADENCE_S=30
# Probes post this many ticks under the bid (5 filled once on a fast move).
PK_PROBE_BACK_TICKS=20
PK_PAPER_START_CASH_USD=1000
# The order's limit above the touch (0.06 = 6¢), capped at PK_MAX_ENTRY_PX, at
# most 0.15. The Helix holdout supported +2¢ (research/PREREG.md, C1); the
# 10-10/11 tape replay at 250 ms took fills from ~16% to ~25% at +6¢, worth it
# only with the active exit below. Changes fills: bump the epoch.
PK_LIMIT_OFFSET=0.06
# Size an entry at its limit (shares = notional / limit), so a FAK never spends
# more than the notional (it spent $7.10 of a $4.40 notional at touch 0.03).
PK_SIZE_AT_LIMIT=true
# The active exit (pk_core::exit): sell the held leg with a FAK
# PK_ACTIVE_EXIT_TICKS under the bid (never where both fees leave under 1¢) once Polymarket's bid is within 1¢ of Kalshi's price (Kalshi spread
# ≤ 2¢) and above the entry. On the 10-10/11 tape it beat holding to settlement
# on every rule and limit (median 4-7 s in the trade). No fixed take-profits:
# +3/+5/+10¢ all did worse.
PK_ACTIVE_EXIT=true
# A killed exit re-arms at once, one refused for balance (shares not credited
# yet) a second later; after 8 misses, every 5 s.
PK_ACTIVE_EXIT_TICKS=3
# The resting exit (live): while a position is held, a post-only sell rests at
# Kalshi's price (never under the exit floor), re-priced when that moves a cent
# and taken off the book 5 s before the close. No taker hold, no maker fee. The
# FAK exit stays the fallback, firing once the bid reaches Kalshi's price; it
# cancels the rest first. In the config hash when true.
PK_REST_EXIT=false
# Order at most the shares offered at or below the limit at the decision
# (PREREG part 4). In the config hash when true.
PK_SIZE_TO_DEPTH=false

# --- hard risk limits (required) ----------------------------------------------
# 8 assets x one $50 entry per 15-min window, held to settlement: at most
# ~$400 open at once in steady state. Static USD ceilings, also live: one order
# never costs more than PK_MAX_OPEN_NOTIONAL_USD, and the daily loss limit
# reads the ledger's realised P&L and (live) the wallet's equity drawdown.
PK_MAX_OPEN_NOTIONAL_USD=500
PK_DAILY_LOSS_LIMIT_USD=250
# Open positions plus orders in flight (0 = no cap), and at most
# PK_ENTRY_BURST_MAX entries in any PK_ENTRY_BURST_WINDOW_S across all assets,
# shared with the fast path (the assets cross together; 0 = no cap). A wallet
# move of $1+ with nothing in flight is journalled as a `transfer` and moves
# the daily loss limit's baseline with it.
PK_MAX_OPEN_POSITIONS=3
PK_ENTRY_BURST_MAX=2
PK_ENTRY_BURST_WINDOW_S=30

# --- results epoch -----------------------------------------------------------------
# Results (page, read-out, export) are read per epoch, and every journal record
# carries it with the git build. Bump it when a fix invalidates earlier paper
# results: the ledger is archived and starts again from PK_PAPER_START_CASH_USD.
# Records written before epochs existed (the ghost-level period) are excluded.
# 7 from the Rust cutover (the journal and tape formats changed).
PK_RESULTS_EPOCH=7

# --- websockets --------------------------------------------------------------------
# Polymarket sockets, assets spread across them; 0 = one per asset. A socket's
# reconnect drops only its own books (PLAN 2.1).
PK_POLY_SOCKETS=0

# --- the observer process (statistics off the trading loop) ----------------------
# The tape, the journal, markouts, the chart series and feed
# metrics run in a child process (pk-observer); the trader keeps feeds, books,
# the live rule, fills and the ledger. false = everything in one process.
PK_OBSERVER=true
# Its loopback API, read by pk-status (same API_KEY). Never expose it.
PK_OBSERVER_PORT=8052

# --- The fast path (live only) ------------------------------------------------------
# The armed trigger: the Kalshi feed runs on a thread pinned to one core, and
# each frame is checked against the rule (pk_core::decide on the live Kalshi
# quote and the Polymarket quotes the engine armed it with) before it is queued.
# On an entry, a pre-signed order with fresh L2 headers is written as HTTP/1.1
# bytes on a warm TCP_NODELAY connection from that same thread. The engine
# still records, reserves and settles it. ~280 µs → single-digit µs from frame
# to wire; the venue's taker hold (~150-250 ms) is unchanged.
PK_FAST_PATH=false
# Warm HTTP/1.1 connections to the CLOB (one order in flight per connection).
PK_FAST_CONNS=3
# The core the hot thread is pinned to; -1 = the last core.
PK_HOT_CORE=-1
# Busy-poll the hot thread's socket instead of sleeping in epoll: one core at
# 100%, no kernel wake-up on a frame.
PK_HOT_SPIN=true

# --- Reference feeds: lead-lag (observer only, never traded) ----------------------
# Public best bid/ask, written to the tape when the best bid or ask changes, and
# timed against Kalshi and Polymarket: after each reference shock, how long until
# each venue's YES mid moves 1¢ the same way (status page "Lead–lag"; journal
# leadlag_shock). No API keys, except Helius for LaserStream.
# Binance spot and USDⓈ-M perp (venues n and f; AWS Tokyo). HYPE is perp only.
PK_BINANCE=true
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_PERP_WS_URL=wss://fstream.binance.com/public/stream
# Kraken v2 ticker on best bid/offer changes (venue r; London).
PK_KRAKEN=true
KRAKEN_WS_URL=wss://ws.kraken.com/v2
# Bitstamp order book, top of book about every 100 ms (venue t).
PK_BITSTAMP=true
BITSTAMP_WS_URL=wss://ws.bitstamp.net
# Coinbase Exchange ticker: best bid and ask on each trade (venue o; AWS us-east-1).
PK_COINBASE=true
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# Helius LaserStream gRPC: on-chain SOL (Orca and Raydium SOL/USDC pools, Pyth
# SOL/USD) at processed commitment (venue h). Needs a Helius key with LaserStream.
PK_LASERSTREAM=false
LASERSTREAM_URL=https://laserstream-mainnet-lon.helius-rpc.com
HELIUS_API_KEY=

# --- PolyBolt reference prices (optional, recorded only) ------------------------
# Pyth crypto prices and the Chainlink 60 s TWAP the 15-minute markets settle on,
# recorded as venue b by the observer (PLAN 4.1). Needs Polymarket CLOB API
# credentials (all three); leave blank to keep it off.
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=

# --- recording -------------------------------------------------------------------
PK_RECORD_ENABLED=true
# VM: PK_RECORD_DIR=/data/pk/raw/dev
PK_MIN_FREE_DISK_GB=5

# --- Kalshi (signal only; the WS needs an authenticated connection) --------------
KALSHI_API_KEY_ID=replace-with-the-kalshi-key-id
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/poly-kalshi.pem
KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# --- Polymarket (public market data) ----------------------------------------------
POLY_GAMMA_URL=https://gamma-api.polymarket.com
POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- status page (pk-status) ---------------------------------------------------
PK_STATUS_HOST=127.0.0.1
PK_STATUS_PORT=8051

# --- notifications (alerts via notification-service) ------------------------------
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM

# --- inbound Telegram commands (/kill, /status): a bot of its own -----------------
PK_TELEGRAM_BOT_TOKEN=
PK_TELEGRAM_ADMIN_USER_IDS=

# --- order path probe (pk probe-orders) -------------------------------------------
# Real post-only orders below the best bid, cancelled at once: they cannot fill,
# and they time decision -> acknowledgement on a warm HTTP/2 connection. Off
# unless PK_ORDER_PROBE=on. The wallet needs a few pUSD. Their round trips set
# the paper venue's latency (above).
PK_ORDER_PROBE=off
POLY_CLOB_URL=https://clob.polymarket.com
POLY_PRIVATE_KEY=
# The wallet that holds the funds when it is not the EOA: the deposit wallet
# (type 3; the deposit address on polymarket.com) or a proxy/Safe (1, 2; probe
# only). Blank for an EOA.
POLY_FUNDER=
# 0 EOA, 1 proxy, 2 Safe, 3 deposit wallet.
POLY_SIGNATURE_TYPE=0

# --- pk-limitless (Kalshi signal, Limitless leg; a separate process) ------------
# infra/systemd/pk-limitless.service. Paper unless both live flags are set.
# pk-status shows it on its own tab (/limitless) when PK_LIM_ENABLED=true.
PK_LIM_ENABLED=false
PK_LIM_PORT=8053
PK_LIM_EXECUTION_MODE=paper
PK_LIM_LIVE_CONFIRM=
PK_LIM_EPOCH=1
# Limitless lists 15-minute Up/Down markets for BTC and ETH only.
PK_LIM_ASSETS=BTC,ETH
PK_LIM_GAP_THRESHOLD=0.20
PK_LIM_MAX_ENTRY_PX=0.60
PK_LIM_MAX_KALSHI_SPREAD=0.02
PK_LIM_MAX_SPREAD=0.05
PK_LIM_MIN_EDGE=0.10
PK_LIM_MIN_ENTRY_PX=0.20
PK_LIM_MIN_NET_EDGE=0.03
PK_LIM_ORDER_SHARES=10
PK_LIM_LIMIT_OFFSET=0.06
PK_LIM_EXIT_SLIP=0.01
PK_LIM_ACTIVE_EXIT=true
# Taker fee on the new venues: 5% × (1 − price) of the USDC value.
PK_LIM_FEE_RATE=0.05
PK_LIM_PAPER_CASH=100
PK_LIM_PAPER_EXTRA_MS=0
PK_LIM_MAX_OPEN_USD=20
PK_LIM_DAILY_LOSS_USD=10
PK_LIM_NETPROBE_S=5
PK_LIM_RECORD=true
# Order path (probes and live): a scoped API token (website → API Tokens →
# Derive) for the EOA that signs. The key defaults to POLY_PRIVATE_KEY.
LIMITLESS_API_KEY=
LIMITLESS_API_SECRET=
LIMITLESS_PRIVATE_KEY=
# Base RPC (chain 8453): approvals, balances, redeem.
BASE_RPC_URL=
# SOL hourly on Limitless, priced from Helius on-chain SOL (paper only; needs HELIUS_API_KEY).
PK_LIMH_ENABLED=true
PK_LIMH_EPOCH=1
PK_LIMH_MIN_EDGE=0.10
PK_LIMH_MIN_NET_EDGE=0.03
PK_LIMH_MIN_PX=0.20
PK_LIMH_MAX_PX=0.60
PK_LIMH_MAX_SPREAD=0.10
PK_LIMH_EARLY_S=120
PK_LIMH_LATE_S=120
PK_LIMH_VOL_HALFLIFE_S=600
PK_LIMH_BASIS_HALFLIFE_S=300
