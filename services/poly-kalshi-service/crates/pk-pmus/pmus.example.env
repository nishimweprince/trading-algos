# pk-pmus: Kalshi-priced paper entries on Polymarket US (paper only)
PK_PU_MODE=paper
PK_PU_EPOCH=7
PK_PU_MIN_EDGE=0.05
# Delay study: extra book fetches after each decision (never positions)
PK_PU_PAPER_DELAYS_MS=25,50,100,150
# Calibrated Kelly: shadows of these epochs fit beta (counterfactual sizing only)
PK_PU_CAL_EPOCHS=4,5,6,7
# Per-dollar gate (shadow) and dollar sizing (counterfactual)
PK_PU_RPD_MIN=0.10
PK_PU_STAKE_USD=5
# Kelly what-ifs: dollar caps per trade and per window (other rules: 2% / 5% of the bankroll)
PK_PU_KELLY_TRADE_USD=50
PK_PU_KELLY_WINDOW_USD=100
# Quick-exit study: bid walked this many ms after each fill (never sold)
PK_PU_EXIT_DELAYS_MS=1000,2000,5000,10000,20000,30000
PK_PU_ASSETS=BTC,ETH,SOL,XRP
PK_PU_STATE_DIR=/opt/pk-pmus/data/state/pmus
PK_PU_UI_ADDR=127.0.0.1:8095
PK_PU_HOST_TAG=hetzner-ash-paper
KALSHI_API_KEY_ID=<your-kalshi-key-id>
KALSHI_PRIVATE_KEY_PATH=/etc/pk-pmus/kalshi-ed25519.pem
RUST_LOG=info
