# pk-endgame settings. Copy to /etc/pk-endgame.env (chmod 600) for systemd, or
# pass `pk-endgame --env FILE run`. The process environment wins over the file.

# --- mode -------------------------------------------------------------------------
# paper: decide and fill on paper against the live book (nothing is sent).
# live: real FAK orders; also needs PK_EG_LIVE_CONFIRM=yes and the wallet below.
PK_EG_MODE=paper
PK_EG_LIVE_CONFIRM=no

PK_EG_ASSETS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE

# --- the rule ---------------------------------------------------------------------
# Entries from 60 s to 2 s before the close (pkm stops quoting 60 s before the
# close, so the two never overlap).
PK_EG_ENTRY_FROM_S=60
PK_EG_ENTRY_UNTIL_S=2
# The rule set (PREREG.md). Changing any rule below starts a new epoch.
PK_EG_EPOCH=2
# Model probability − ask − taker fee must be between MIN_EDGE and MAX_EDGE:
# above MAX_EDGE the disagreement with the book is taken for model error.
PK_EG_MIN_EDGE=0.04
PK_EG_MAX_EDGE=0.12
# The FAK limit is the ask + LIMIT_OFFSET, never above the price that leaves MIN_NET_EDGE.
PK_EG_MIN_NET_EDGE=0.02
PK_EG_LIMIT_OFFSET=0.01
PK_EG_MIN_PX=0.05
PK_EG_MAX_PX=0.70
# σ: sd of 1 s Chainlink log returns over this many seconds (at least MIN_N returns).
PK_EG_SIGMA_WINDOW_S=300
PK_EG_SIGMA_MIN_N=120
# Floor on the model's sd (log units): our TWAP against Polymarket's own.
PK_EG_SD_FLOOR=0.00005
# The model's sd ×SD_MULT_EARLY while more than SD_MULT_FROM_S seconds remain
# (fitted from epoch 1; eg_refit.py re-fits it weekly and reports).
PK_EG_SD_MULT_EARLY=1.5
PK_EG_SD_MULT_FROM_S=30
# Seconds of the opening average we must have seen (of 60); the process has to
# be up at a window's open for that window to trade.
PK_EG_MIN_OPEN_TICKS=45
PK_EG_MAX_TICK_AGE_MS=3000
PK_EG_MAX_ENTRIES_PER_WINDOW=1
PK_EG_SHARES=10

# --- Kalshi (read-only market data) ------------------------------------------------
# Kalshi's mid for the same side (same window, BRTI 60 s averages) must clear
# the Polymarket ask and fee by KALSHI_MIN_MARGIN; its book ≤ KALSHI_MAX_AGE_MS
# old with a spread ≤ KALSHI_MAX_SPREAD. Without a fresh Kalshi book: no entry.
PK_EG_KALSHI_FILTER=yes
PK_EG_KALSHI_MIN_MARGIN=0
PK_EG_KALSHI_MAX_AGE_MS=3000
PK_EG_KALSHI_MAX_SPREAD=0.05
# A read-only Kalshi API key (Ed25519 or RSA, PEM private key).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/pk-endgame/kalshi-ed25519.pem
# KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2

# --- spot (recorded only; no entry rule reads it) ----------------------------------
# Coinbase and Binance best bid/ask, and a spot-adjusted copy of the model, are
# written to every eg_sec line and decision, to test whether spot closes the
# gap between our model and Polymarket's price.
PK_EG_SPOT=yes
# COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# --- paper ------------------------------------------------------------------------
# Decision → the book the paper order fills against. 250 ≈ the measured live
# taker path from Dublin (~225 ms decision → acknowledgement).
PK_EG_PAPER_LATENCY_MS=250

# --- risk -------------------------------------------------------------------------
PK_EG_MAX_OPEN_COST_USD=50
# Realised −$15 today halts entries (persisted) until the next UTC day or <state>/ACK.
PK_EG_DAILY_LOSS_USD=15
# Per-second grid lines from this many seconds before each close.
PK_EG_GRID_FROM_S=90

PK_EG_STATE_DIR=data/state/endgame

# --- the monitoring page ------------------------------------------------------------
# Where it listens ("off" for none). Off loopback it needs the token.
PK_EG_UI_ADDR=127.0.0.1:8095
# HTTP Basic password (any user name), at least 16 characters.
PK_EG_UI_TOKEN=
# A name for this host on the page (no spaces).
PK_EG_HOST_TAG=
# PK_EG_KILL_FILE=data/state/endgame/KILL

# --- wallet: live only ------------------------------------------------------------
# Use a wallet of its own, not pkm's: the two would share cash and token balances.
POLY_PRIVATE_KEY=
# POLY_PRIVATE_KEY_FILE=/etc/pk-endgame.key
POLY_FUNDER=
POLY_SIGNATURE_TYPE=3
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=
# An EOA (type 0) redeems on-chain and needs:
POLYGON_RPC_URL=

# --- endpoints (defaults shown) ---------------------------------------------------
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# POLY_RTDS_URL=wss://ws-live-data.polymarket.com
# POLY_CLOB_URL=https://clob.polymarket.com
