# /etc/crossex-hl.env — root-owned, mode 0600. Second instance: Binance ↔ Hyperliquid.
# It runs beside the Binance ↔ Bybit service (/etc/crossex.env) with its own journal
# directory, status port, and kill file. Binance needs a READ-ONLY key as before.
CXA_BINANCE_API_KEY=
CXA_BINANCE_API_SECRET=

# Hyperliquid needs no API key in shadow. The public address only selects the fee
# tier (userFees); no signing key is ever loaded.
CXA_PEER=hyperliquid
CXA_HL_ADDRESS=

CXA_ALLOW_TRADING_KEYS=0

# Bare names are Binance symbols; HL coins are derived (1000PEPEUSDT -> kPEPE).
# Chosen 2026-10-21: HL 24h volume >= ~$5M and L1 depth >= ~$300 (HYPE, ZEC added).
CXA_BASKET=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,1000PEPEUSDT,SUIUSDT,AVAXUSDT,LINKUSDT,LTCUSDT,ARBUSDT,NEARUSDT,APTUSDT,TIAUSDT,FILUSDT,WLDUSDT,BCHUSDT,UNIUSDT,ENAUSDT,HYPEUSDT,ZECUSDT

CXA_JOURNAL=/data/crossex-hl/crossex-hl-%Y%m%dT%H%M%SZ.jsonl
CXA_KILL_FILE=/data/crossex-hl/KILL
CXA_STATUS_PORT=8071

# PREREG-HL gate: pessimistic latency (p95 of measured RTT / 2, plus 1 ms) plus the
# HL block-inclusion delay on every Hyperliquid leg.
CXA_LATENCY_MODE=pessimistic
CXA_ENGINE_PENALTY_NS=1000000
CXA_HL_INCLUSION_NS=200000000
CXA_AVAILABLE_PPM=500000
CXA_TRADE_NOTIONAL=250

CXA_EXEC_MODE=maker_taker
CXA_MAKER_TIMEOUT_MS=2000

# Strategy defaults (same as PREREG.md). Changing any of these during the PREREG-HL
# window invalidates the gate.
CXA_MIN_NET_PPM=0
CXA_SAFETY_PPM=0
CXA_EXIT_BAND_PPM=200
CXA_BASIS_HALFLIFE_MS=1800000
CXA_BASIS_WARMUP_MS=600000
CXA_EXPECTED_HOLD_MS=600000
CXA_MAX_HOLD_MS=1800000
CXA_FUNDING_GUARD_MS=120000
CXA_FUNDING_TOLERANCE_PPM=100
CXA_PAIR_STOP_PPM=15000
CXA_COOLDOWN_MS=5000

CXA_MAX_OPEN_PAIRS=3
CXA_MAX_PAIR_NOTIONAL=5000
CXA_DAILY_LOSS=200
CXA_MAX_FEED_AGE_NS=1000000000
CXA_MAX_BOOK_AGE_NS=60000000000
