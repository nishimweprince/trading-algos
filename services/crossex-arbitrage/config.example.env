# /etc/crossex.env — root-owned, mode 0600. Phase 1 needs READ-ONLY keys only:
# the service refuses to start if either key can trade, transfer, or withdraw.
CXA_BINANCE_API_KEY=
CXA_BINANCE_API_SECRET=
CXA_BYBIT_API_KEY=
CXA_BYBIT_API_SECRET=

# Basket: name or name:binanceSymbol:bybitSymbol. Same contract unit on both venues.
CXA_BASKET=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,1000PEPEUSDT,SUIUSDT,WIFUSDT,AVAXUSDT,LINKUSDT,ADAUSDT,LTCUSDT,ARBUSDT,OPUSDT,NEARUSDT

CXA_JOURNAL=/data/crossex/crossex-%Y%m%dT%H%M%SZ.jsonl
CXA_KILL_FILE=/data/crossex/KILL
CXA_STATUS_PORT=8070

# PREREG gate runs with pessimistic latency (p95 of measured signed RTT / 2).
CXA_LATENCY_MODE=pessimistic
CXA_ENGINE_PENALTY_NS=1000000
CXA_AVAILABLE_PPM=500000
CXA_TRADE_NOTIONAL=1000

# Strategy defaults (see STRATEGY_SPEC.md). Changing any of these during the
# PREREG window invalidates the gate.
CXA_MIN_NET_PPM=1000
CXA_SAFETY_PPM=0
CXA_EXIT_BAND_PPM=200
CXA_BASIS_HALFLIFE_MS=1800000
CXA_BASIS_WARMUP_MS=600000
CXA_EXPECTED_HOLD_MS=600000
CXA_MAX_HOLD_MS=1800000
CXA_FUNDING_GUARD_MS=120000
CXA_FUNDING_TOLERANCE_PPM=100
CXA_PAIR_STOP_PPM=15000
CXA_COOLDOWN_MS=5000

# Risk
CXA_MAX_OPEN_PAIRS=3
CXA_MAX_PAIR_NOTIONAL=5000
CXA_DAILY_LOSS=200
CXA_MAX_FEED_AGE_NS=1000000000
CXA_MAX_BOOK_AGE_NS=60000000000
