# ofi-scalper-service, profile "dev" (Stage 0–1). Copy to .env.dev and fill in.
# Nothing here can place an order: there is no order path in this build.
#
# Active values are the recommended Azure Tokyo (Japan East) setup. Lines marked
# "Mac:" are the fallback for running on a slow link (measured 2026-10-01/02:
# diff depth and bookTicker fell seconds behind and dropped from the Mac).
#
# Azure VM checklist (not settings, but the service assumes them):
#   - Region Japan East; Ubuntu LTS; a few vCPUs is plenty (the process idles
#     at a few % CPU). Accelerated networking on.
#   - Static public IP, whitelisted on the Binance key.
#   - A managed data disk for recordings, mounted at /data (fstab by UUID, with
#     nofail), owned by the service user: sudo mkdir -p /data/ofi && sudo chown
#     $USER: /data/ofi. NOT /mnt: on Azure that is usually the temporary resource
#     disk, wiped on deallocate, resize or host maintenance.
#   - Run as the normal service user, never with sudo: root-owned logs/ and
#     data/ break the next unprivileged start.
#   - Clock sync on (chrony; Azure's PTP source). Feed latency is measured
#     against Binance's event time, so local clock error shows up in it.
#   - Service ports stay private: HOST stays 127.0.0.1; reach the API over SSH
#     (ssh -L 8030:127.0.0.1:8030 vm). No inbound rule for 8030 in the NSG.
#   - First run: ofi-latency --profile dev --seconds 120, then a diff-mode
#     session; confirm the futures streams connect and keep up from Azure's IPs.

# --- service ---------------------------------------------------------------
# openssl rand -hex 24
API_KEY=replace-with-a-long-random-key
HOST=127.0.0.1
PORT=8030
LOG_LEVEL=INFO
# Tags latency.json and recording manifests. Only numbers measured in Tokyo
# count for the research gates (2x measured latency must still be profitable).
OFI_HOST_TAG=azure-tokyo
# Mac: OFI_HOST_TAG=mac

# --- Binance USDⓈ-M (plugin: ta-plugin-binance-futures) ----------------------
BINANCE_FUTURES_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# Root only; the plugin adds /public and /market.
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# Book mode. diff: the full event-level book from <s>@depth@0ms plus REST
# snapshots; what the strategy is designed on (multi-level OFI per event).
# partial: complete top-N snapshots, stateless and a few KB/s per symbol.
BINANCE_FUTURES_BOOK_MODE=diff
BINANCE_FUTURES_DEPTH_SPEED=0ms
BINANCE_FUTURES_DEPTH_SNAPSHOT_LIMIT=1000
# Mac: BINANCE_FUTURES_BOOK_MODE=partial
# partial mode only. Speeds are 100ms, 250ms (Binance's unsuffixed default) or 500ms.
BINANCE_FUTURES_PARTIAL_LEVELS=10
BINANCE_FUTURES_PARTIAL_SPEED=100ms

# Empty = auto: on in diff mode (touch updates, recorded for research), off in
# partial mode. It is the heaviest stream.
BINANCE_FUTURES_BOOK_TICKER=
BINANCE_FUTURES_AGG_TRADES=true

# Half of Binance's 2400/min IP weight: room for resync snapshots (20 each).
BINANCE_FUTURES_REQUEST_WEIGHT_PER_MINUTE=1200
BINANCE_FUTURES_TIMEOUT_SECONDS=10
# Close to Binance, a short reconnect backoff loses less data after a drop.
BINANCE_FUTURES_RECONNECT_MAX_BACKOFF_SECONDS=10
# Mac: BINANCE_FUTURES_RECONNECT_MAX_BACKOFF_SECONDS=30

# READ-ONLY key ("Enable Reading" only; no futures trading, no withdrawals),
# restricted to the VM's static IP. Used for fee tier / commission rates and
# signed-request RTT. Leave both empty to run on public data only.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_RECV_WINDOW_MS=5000

# --- mode, sampling, recording -------------------------------------------------
# off | shadow ("live" is refused until the research gates pass)
OFI_EXECUTION_MODE=off
OFI_GRID_MS=100
OFI_BURST_TRADES=20
OFI_RECORD_ENABLED=true
# Put recordings on the managed data disk (not the OS disk, and never /mnt on
# Azure: that is the temporary disk). Diff mode at 0ms for
# BTC+ETH is several GB/day compressed (estimate; check the first day's files
# with ofi-gapcheck and du). Partial mode on the Mac measured ~110 MB/day.
OFI_RECORD_DIR=/data/ofi/raw/dev
# Mac: OFI_RECORD_DIR=data/raw/dev
# Diff depth at 0ms updates many times a second in Tokyo; half a second with
# nothing is already abnormal (plan §5 suggests 500-1000 ms).
OFI_STALE_BOOK_MS=500
# Mac: OFI_STALE_BOOK_MS=750

# --- fees (leave empty to read them from Binance with the read-only key) -------
# Measured 2026-10-02: fee tier 0, maker 2.0 bp, taker 5.0 bp.
OFI_MAKER_FEE_BP=
OFI_TAKER_FEE_BP=
OFI_BNB_FEE_DISCOUNT=false

# --- hard risk limits (required; frozen at startup) -----------------------------
# Sized for Stage 5 small live (plan §4) on ~$500 allocated capital; scale all
# four dollar figures with the real allocation. Binance minimums (2026-10-02):
# BTCUSDT 0.001 lot ~ $85, ETHUSDT $20 notional. Intended trade: 2 BTC lots
# (~$170) or ~$50-150 ETH.
OFI_MAX_POSITION_NOTIONAL_USD=250
# Below 2x the per-symbol cap: BTC and ETH move together, so both full is one bet.
OFI_MAX_TOTAL_NOTIONAL_USD=400
# 3% of $500; a full stop-out is ~11-15 bp on $170 (~$0.25), so this trips on a
# broken day, not on normal variance.
OFI_DAILY_LOSS_LIMIT_USD=15
OFI_MAX_DRAWDOWN_PCT=10
# Any single order above the intended trade size waits for a human.
OFI_MANUAL_APPROVAL_NOTIONAL_USD=200
OFI_ORDER_RATE_FRACTION=0.5
# touch this file to halt; remove it, then POST /v1/kill/ack to resume.
# OFI_KILL_FILE_PATH=data/KILL.dev

# --- deterministic regime gate (empty disables a rule) -------------------------
OFI_FUNDING_BLACKOUT_MINUTES=2
OFI_GATE_SPREAD_PCTL=95
# Set after a few days of Tokyo recordings: std of 100 ms mid returns over 60 s, in bp.
OFI_GATE_VOL_1M_BP=
# Liquidation notional in the last 60 s that switches a symbol off.
OFI_GATE_LIQ_BURST_USD=

# --- Telegram /kill and /status (a NEW bot, not notification-service's) -------
# Create with @BotFather. Must differ from notification-service's TG_BOT_TOKEN.
# Only one process may poll a bot: do not run this profile on the Mac and the
# VM at the same time with the same token.
OFI_TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Required with the token.
OFI_TELEGRAM_ADMIN_USER_IDS=

# --- outbound alerts via notification-service -----------------------------------
# Run notification-service on the same VM (port 3010, loopback only), or set
# NOTIFICATIONS_ENABLED=false until it is deployed there.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=replace-with-notification-service-api-key
NOTIFICATION_CHANNELS=TELEGRAM
