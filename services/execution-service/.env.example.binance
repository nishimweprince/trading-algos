# execution-service, profile "binance": order entry on Binance USDⓈ-M futures.
# Copy to .env.binance (chmod 600). Testnet (demo trading) until the OFI
# scalper's research gates pass and you approve mainnet explicitly.
ADAPTERS=binance_futures

# --- service -------------------------------------------------------------------
# openssl rand -hex 24  (the scalper's EXECUTION_API_KEY must match)
API_KEY=replace-with-a-long-random-key
HOST=127.0.0.1
PORT=8010
LOG_LEVEL=INFO
EXECUTION_DATABASE_PATH=data/executions.binance.sqlite3
EVENTS_LOG_PATH=logs/events.binance.jsonl

# --- gates (checked on every order) ----------------------------------------------
# Who may call /v1/orders. The OFI scalper sends source "ofi_scalper".
ALLOWED_ORDER_SOURCES=ofi_scalper
# Base-asset quantity cap per order (BTC: 0.001 lot ~ $85 on 2026-10-02).
MAX_VOLUME_LOTS=0.005
TRADING_ENABLED=true
# Mainnet only; leave false on testnet. Kill controls work regardless.
LIVE_TRADING_ENABLED=false
SIGNAL_MAX_AGE_SECONDS=10
EXECUTION_RESPONSE_TIMEOUT_SECONDS=5
RECONCILE_INTERVAL_SECONDS=30
STARTUP_READY_TIMEOUT_SECONDS=30

# --- Binance USDⓈ-M ----------------------------------------------------------------
BINANCE_FUTURES_SYMBOLS=BTCUSDT,ETHUSDT
# testnet = Binance demo trading (demo-fapi / demo-fstream); mainnet = real money.
BINANCE_FUTURES_ENV=testnet
# A TRADING key, separate from the scalper's read-only key: futures trading only,
# withdrawals disabled, IP-restricted to this host. Testnet keys come from
# Binance demo trading, not from the main site.
BINANCE_FUTURES_TRADING_API_KEY=replace-with-trading-key
BINANCE_FUTURES_TRADING_API_SECRET=replace-with-trading-secret
# Account alias the scalper targets (default binance_testnet / binance).
# BINANCE_FUTURES_ACCOUNT_ALIAS=binance_testnet
# Preflight (verified at start, never changed by the service): one-way mode,
# single-asset margin, leverage at most this, isolated margin per symbol.
BINANCE_FUTURES_MAX_LEVERAGE=2
BINANCE_FUTURES_REQUIRE_ISOLATED=true
# Empty = the environment's host. Override only to test against another endpoint.
BINANCE_FUTURES_TRADING_REST_URL=
BINANCE_FUTURES_TRADING_WS_URL=

# --- alerts --------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=replace-with-notification-service-api-key
NOTIFICATION_CHANNELS=TELEGRAM
