# HFM MetaTrader 5 profile — copy to .env.hfm and run with --profile hfm.
# Placeholder values (including MT5_LOGIN=0) deliberately prevent validation until filled.
ADAPTERS=mt5

# Exact terminal/account details from the HFM MT5 account welcome email and terminal.
MT5_TERMINAL_PATH=replace-with-absolute-hfm-terminal64-exe-path
MT5_LOGIN=0
MT5_PASSWORD=replace-with-hfm-account-password
MT5_SERVER=replace-with-exact-hfm-mt5-server-name
MT5_TIMEOUT_MS=60000

# Shared HTTP authentication. Use a distinct high-entropy key for this profile.
API_KEY=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=8000

# Gold-only broker symbols are loaded from this profile-specific manifest.
SYMBOLS_FILE=symbols.hfm.json
ALLOWED_SIGNAL_SOURCES=trading_central,autochartist,lux_algo,ipda,session_hedging
MAXIMUM_VOLUME=1.00
MAGIC_NUMBER=234100
DEFAULT_DEVIATION_POINTS=10
MAXIMUM_DEVIATION_POINTS=20
SIGNAL_MAX_AGE_SECONDS=60
FUTURE_TOLERANCE_SECONDS=5
MAX_CANDLES_LOOKBACK=5000

# Keep each profile's durable state and append-only logs separate.
DATABASE_PATH=data/signals.hfm.sqlite3
SIGNALS_LOG_PATH=logs/signals.hfm.jsonl
EVENTS_LOG_PATH=logs/events.hfm.jsonl
LOG_LEVEL=INFO

# Fail closed until the account, symbols, risk cap, and idempotency behavior are verified.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false

# Opt in only after OCO verification and recovery checks.
MT5_OCO_ENABLED=false
MT5_OCO_POLL_SECONDS=0.25
# Verified on HFMarketsGlobal-Live20 on 2026-09-15; recheck seasonal changes.
MT5_OCO_SERVER_UTC_OFFSET_SECONDS=10800

# Notification recipients/channels are managed by notification-service.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=https://notifications.nishimweprince.dev
NOTIFICATION_API_KEY=replace-with-notification-service-api-key
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30
