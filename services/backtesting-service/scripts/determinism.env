# Pinned environment for scripts/determinism_gate.py.
#
# The gate's four hashes only mean something if everyone runs them against the
# same settings. It used to call load_settings(), which reads the developer's
# own gitignored .env -- so the published hashes were reproducible on exactly
# one machine, and a fresh clone could not check them at all.
#
# Derived verbatim from the .env those hashes were produced under, with the
# three credential values replaced: all four cases use source=local and never
# reach the gateway.
#
# Do NOT edit this to make a failing gate pass. A moved hash is the finding.

# Copy to .env before `session-hedging`.

# ctrader-markets gateway (required for seed, paper, and source=ctrader backtests)
CTRADER_MARKETS_URL=http://127.0.0.1:8010
CTRADER_API_KEY=determinism-gate-not-a-real-key

# Optional auth on this service. Leave empty to disable.
API_KEY=

HOST=0.0.0.0
PORT=8012
LOG_LEVEL=INFO

# --- Strategy identity ------------------------------------------------------
# The paper/live loop reads ONLY this file. The backtest UI sends its parameters
# with each request, so a validated backtest proves nothing about what runs here
# unless these match. Validated run: XAUUSD H1 oco_bracket, candle set aca20202..1debc2.
ENTRY_MODE=oco_bracket
OCO_BUFFER_MODE=orb_frac
OCO_BUFFER_VALUE=0.5
OCO_EXPIRY_BARS=1
ALLOW_REENTRY=false

SYMBOL=XAUUSD
# Paper/live default. Backtests send timeframe from the client.
TIMEFRAME=H1
PIP_SIZE=0.1
LOCK_PIPS=20
# Move the stop to entry +LOCK_PIPS once the trade has run this many R in favour.
# 0 disables it. Note that without this, LOCK_PIPS is dead in oco_bracket mode: the
# incumbent lock only fires when one leg of a hedge pair is stopped and the other
# survives, and an OCO bracket cancels its sibling on fill, so that path is unreachable.
#
# MEASURED OFF on XAUUSD H1 (503 structures, 2024-12 to 2026-08). On 501 matched
# structures the ratchet at 0.75R raised the win rate 41.9% -> 57.5% but cut expectancy
# 59.1 -> 41.7 pips: it helped 92 trades for +19,191 pips and hurt 85 for -27,914.
# The strategy's profit lives in ~66 outsized winners; a breakeven stop clipped 10 of
# them, and single clips cost 1,300-2,000 pips each while a rescued loser saved ~450.
# Every trigger from 0.5R to 2.5R measured at or below the expectancy of leaving it off.
# ENABLED at 0.75R by explicit instruction, against that measurement. The trade being
# made is expectancy for hit rate and slippage tolerance: 0.75R is far enough from
# entry that the stop move survives real fills, and the higher win rate is easier to
# hold through live. Re-measure before changing the trigger.
BE_TRIGGER_R=2
# SL_MULT=2 and RR=3 are load-bearing, not placeholders. Measured on XAUUSD H1:
# 44% of winners took more than 0.75R of heat, so a tighter stop cuts the winners;
# and every take-profit below 3R tested worse, because the ~21% of trades that reach
# 3R pay for the rest. Change these only against fresh measurement.
SL_MULT=2
RR=3
# Comma-separated UTC hours to refuse entries on, e.g. "13". Off when empty.
# WARNING: sessions are anchored in *local* time, so one local anchor maps to two UTC
# hours across a daylight-saving change. On this data New York 09:00 appears at 13:00
# UTC (EDT, 108 trades) and 14:00 UTC (EST, 55 trades) -- excluding 13 excludes summer,
# not an hour of the day. Set by explicit instruction as a cost-efficiency measure:
# 13:00 UTC ran 108 structures at PF 0.99 for -244 pips, so it spends cost budget to
# break even. Note that this drops New York for the EDT half of the year entirely.
ENTRY_HOURS_UTC_EXCLUDE=13
MIN_STOP_PIPS=0
QTY=1
SKIP_DOJI=true
INITIAL_CAPITAL=100000
# Pips versus dollars is chosen in the UI, per run, not here. Selecting dollars asks for a
# dollar-per-pip rate at QTY=1, defaulting to 10.

# --- Execution costs -------------------------------------------------------
# PIP_SIZE=0.1, so 1 pip = $0.10 per ounce and a 100 oz lot moves $10 per pip.
# These are XAUUSD retail/raw estimates. Replace them with your own broker's fills
# before sizing anything: a backtest run at zero cost is biased toward over-trading,
# because every marginal low-edge trade looks free.
COST_MODEL=per_session
# Raw-spread gold typically quotes $0.15-0.30 wide => ~1.5 pips per side.
SPREAD_PIPS_PER_SIDE=1.5
# Breakout entries are stop orders and pay for the move they chase.
SLIPPAGE_PIPS_PER_SIDE=1.5
# ~$3.50 per 100 oz lot per side = $0.035/oz = 0.35 pips.
COMMISSION_PIPS_PER_SIDE=0.35
# Overnight financing. MAX_AGE_HOURS=24 means most structures cross a rollover.
SWAP_LONG_PIPS_PER_ROLLOVER=2.0
SWAP_SHORT_PIPS_PER_ROLLOVER=1.0
SWAP_ROLLOVER_TIME=17:00
SWAP_TIMEZONE=America/New_York
SWAP_TRIPLE_WEEKDAY=wednesday
# Tokyo's book is thinner; London/New York inherit the base schedule.
SESSION_COST_OVERRIDES={"tokyo": {"spread_pips_per_side": 2.5, "slippage_pips_per_side": 2.0}}
BREAKEVEN_COST_REPORT=true

TRADING_SESSIONS=tokyo,london,new_york
SESSION_TOKYO=Asia/Tokyo:09:00-18:00
SESSION_LONDON=Europe/London:08:00-16:30
SESSION_NEW_YORK=America/New_York:08:00-17:00

PAPER_ENABLED=true
POLL_INTERVAL_SECONDS=60
PAPER_LOOKBACK=200

DATA_DIR=data
LOGS_DIR=logs

# Optional paper notifications (ipda/mt5-trader contract). Off by default.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30

# --- Market execution (ctrader-markets) -------------------------------------
# off    : no bridge is built. The service is a simulation. Default.
# shadow : the exact order payload is built, recorded and shown, but never sent.
# live   : orders are submitted to the account named below.
MARKET_EXECUTION_MODE=off
# A ctrader-markets registry alias, e.g. forex_demo. Required unless mode is off.
EXECUTION_CTRADER_ACCOUNT=
# Broker size, deliberately independent of QTY. QTY=1 means one standard lot
# (~$10/pip on gold); this is what actually reaches the broker.
EXECUTION_VOLUME_LOTS=0.01
# Must appear in the gateway's ALLOWED_ORDER_SOURCES or every order is refused.
EXECUTION_SOURCE=session_hedging
EXECUTION_TIMEOUT_SECONDS=10
# Consecutive gateway failures before the bridge halts itself.
EXECUTION_MAX_CONSECUTIVE_FAILURES=5
