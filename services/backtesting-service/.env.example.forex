# HFM execution profile. Copy to .env.forex and run with --profile forex; the broker remains HFM.
# HFM provides candle data and execution through the MT5 gateway.
MARKET_DATA_PROVIDER=mt5
MT5_MARKET_DATA_SYMBOL=XAUUSDb
MT5_MARKET_DATA_SERVER_UTC_OFFSET_SECONDS=10800
CTRADER_MARKETS_URL=http://127.0.0.1:8010
CTRADER_API_KEY=replace-with-ctrader-markets-api-key

# Protect this service's HTTP API before exposing it outside localhost.
API_KEY=replace-with-backtesting-service-api-key
HOST=127.0.0.1
PORT=8012
LOG_LEVEL=INFO

# Gold-only paper strategy feeding the HFM MT5 signal endpoint.
SYMBOL=XAUUSD
TIMEFRAME=M15
PIP_SIZE=0.1
ENTRY_MODE=synthetic_breakout
# To preserve opening-range OCO rules, set ENTRY_MODE=oco_bracket and explicitly select:
# MT5_OCO_EXECUTION=local_market   # one market entry when the closed-bar engine observes a trigger
# MT5_OCO_EXECUTION=broker_pending # gateway owns both pending stops and sibling cancellation
MT5_OCO_EXECUTION=disabled
MT5_EXECUTION_SYMBOL=XAUUSDb
# Exact case matters. Match the HFM host's symbols.hfm.json and broker symbol catalog.
EXECUTION_MAX_OBSERVATION_AGE_SECONDS=120
# broker_pending requires execution-service MT5_OCO_ENABLED=true, a hedge account,
# and a verified MT5_OCO_SERVER_UTC_OFFSET_SECONDS (HFM currently 10800).
# specified symbol expiry, and the /v1/mt5 OCO capability contract.
TP_MODE=fixed_r
RR=3.0
BE_TRIGGER_R=0
TIME_EXIT_MODE=none
ALLOW_REENTRY=false

TRADING_SESSIONS=tokyo,london,new_york
SESSION_TOKYO=Asia/Tokyo:09:00-18:00
SESSION_LONDON=Europe/London:08:00-17:00
SESSION_NEW_YORK=America/New_York:08:00-17:00
PAPER_ENABLED=true
POLL_INTERVAL_SECONDS=15
PAPER_LOOKBACK=200

# Live means signals are submitted. HFM execution-service still fails closed until its
# MT5 credentials plus TRADING_ENABLED/LIVE_TRADING_ENABLED gates are configured.
MARKET_EXECUTION_MODE=live
EXECUTION_PROVIDER=mt5
EXECUTION_MT5_PROFILE=hfm
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=replace-with-hfm-execution-service-api-key
MT5_DEVIATION_POINTS=10
MT5_IGNORE_SIGNAL_AGE=false
EXECUTION_VOLUME_LOTS=0.01
EXECUTION_SOURCE=session_hedging
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MAX_CONSECUTIVE_FAILURES=5

# Legacy compatibility flags. MARKET_EXECUTION_MODE is this bridge's actual gate;
# the HFM execution-service TRADING_ENABLED/LIVE_TRADING_ENABLED gates are authoritative.
LIVE_TRADING_AUTHORIZED=false
TRADING_ENABLED=false

DATA_DIR=data
LOGS_DIR=logs/hfm

NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=https://notifications.nishimweprince.dev
NOTIFICATION_API_KEY=replace-with-notification-service-api-key
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30
