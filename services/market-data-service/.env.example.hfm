# HFM forex — one MetaTrader 5 terminal, so one process.
# Copy to .env.hfm and run on the Windows host with --profile hfm. The
# MetaTrader5 package attaches a process to exactly one terminal; a second
# terminal needs a second profile and port.
MT5_TERMINAL_PATH=replace-with-absolute-hfm-terminal64-exe-path
MT5_LOGIN=0
MT5_PASSWORD=replace-with-hfm-account-password
MT5_SERVER=replace-with-exact-hfm-mt5-server-name
MT5_TIMEOUT_MS=60000

# Broker-server time minus UTC, in seconds (UTC+3 is 10800). MT5 stamps every
# bar and tick in server time; this is what turns them into UTC. Startup logs
# mt5_server_offset_suspect when the newest tick disagrees by over a minute.
MT5_SERVER_UTC_OFFSET_SECONDS=10800
# Quotes are polled (MT5 pushes nothing to Python) for the tick stream and the
# staleness check.
MT5_QUOTE_POLL_SECONDS=1

# Canonical quote name to exact broker symbol, and the market it serves.
SYMBOLS_FILE=data/symbols.hfm.json
MARKETS_CONFIG_PATH=data/markets.hfm.toml

API_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=8021

MAX_CANDLES_LOOKBACK=5000
STARTUP_READY_TIMEOUT_SECONDS=20
SUBSCRIBER_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=15
TICK_STALENESS_SECONDS=60

EVENTS_LOG_PATH=logs/events.hfm.jsonl
LOG_LEVEL=INFO
