# cTrader market data on the macOS host — copy to .env.ctrader and run with
# --profile ctrader. Serves every market named in MARKETS_CONFIG_PATH from the
# cTrader accounts in ACCOUNTS_CONFIG_PATH (forex and the Deriv cTrader account).
#
# Use a SEPARATE OAuth grant from execution-service, ideally with view-only
# scope. cTrader rotates the refresh token on every refresh and invalidates the
# previous one, so two processes sharing a grant or a token cache lock each
# other out. The one-time browser OAuth flow is in the README.
CTRADER_CLIENT_ID=replace-with-openapi-client-id
CTRADER_CLIENT_SECRET=replace-with-openapi-client-secret
CTRADER_ACCESS_TOKEN=replace-with-view-only-oauth-access-token
CTRADER_REFRESH_TOKEN=replace-with-view-only-oauth-refresh-token

# Which accounts to connect (same TOML format as execution-service) and which
# market each one serves.
ACCOUNTS_CONFIG_PATH=data/accounts.ctrader.toml
MARKETS_CONFIG_PATH=data/markets.ctrader.toml

# Optional override of the broker endpoint. Leave unset: the host is derived
# from each account's environment (demo.ctraderapi.com / live.ctraderapi.com).
# CTRADER_PORT=5035

# API authentication. Any value still starting with "replace-with-" is rejected
# at startup — this placeholder is 32 characters and would otherwise satisfy the
# 16-character minimum while being publicly known.
API_KEY=replace-with-a-long-random-secret

HOST=127.0.0.1
PORT=8020

# Cap on requested bar lookback for GET /v1/{market}/candles
MAX_CANDLES_LOOKBACK=5000

# Connection tuning. HEARTBEAT_INTERVAL_SECONDS must stay under 10 — the broker
# drops connections that go silent for longer.
HEARTBEAT_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
RECONNECT_INITIAL_BACKOFF_SECONDS=1
RECONNECT_MAX_BACKOFF_SECONDS=60
# A connection must stay up this long before its backoff counts as recovered.
RECONNECT_STABILITY_SECONDS=30

# How long startup waits for the first handshake before serving anyway.
# /health/ready reports the real state and the supervisor keeps retrying.
STARTUP_READY_TIMEOUT_SECONDS=20

# Per-SSE-subscriber buffer. On overflow the oldest quote is dropped, because a
# newer quote supersedes a stale one.
SUBSCRIBER_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=15

# /health/ready reports not_ready when a market's newest quote is older than this.
TICK_STALENESS_SECONDS=60

# cTrader allows 5 historical requests/second per connection.
HISTORICAL_REQUESTS_PER_SECOND=4

# Rotated OAuth tokens are persisted here. Losing this file means redoing the
# browser OAuth flow. Keep it out of git and never share it with another process.
TOKEN_CACHE_PATH=data/token-cache.ctrader.json

# Append-only JSONL record of every event, including those also printed to stdout.
EVENTS_LOG_PATH=logs/events.ctrader.jsonl

LOG_LEVEL=INFO

# Crypto spot from Binance's public API ([crypto] in the markets file). No key
# needed. Symbols are Binance's own names and are the canonical ones.
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
# Client-side REST weight budget; Binance allows 6000 per minute per IP.
# BINANCE_REQUEST_WEIGHT_PER_MINUTE=4800
