# /home/ll/leadlag/.env (chmod 600). Read by all leadlag units.

# --- trader ---
LL_MODE=record
LL_LEADERS=BTCUSDT,ETHUSDT
# Recorded followers. Until M3 freezes the universe, record the top screen
# candidates (llfetch candidates); each adds ~0.2–0.3 GB/day of tape.
LL_FOLLOWERS=SOLUSDT,XRPUSDT,DOGEUSDT,SUIUSDT,BNBUSDT,ZECUSDT,NEARUSDT,UNIUSDT,ENAUSDT,WLDUSDT,1000PEPEUSDT,ADAUSDT
LL_WS_URL=wss://fstream.binance.com
LL_OBSERVER_SOCK=/run/leadlag/observer.sock
LL_ADMIN_ADDR=127.0.0.1:8060
LL_RING_MB=64
LL_WAIT_OBSERVER=30s

# --- observer ---
LL_TAPE_DIR=/data/leadlag/tape
LL_OBSERVER_ADDR=127.0.0.1:8061
LL_DISK_MAX_PCT=90

# --- status page ---
LL_STATUS_ADDR=127.0.0.1:8062
LL_TRADER_STATUS_URL=http://127.0.0.1:8060/v1/status
LL_OBSERVER_STATS_URL=http://127.0.0.1:8061/v1/stats
LL_PROBE_FILE=/home/ll/leadlag/probe.json

# --- archive / research (llfetch, llresearch) ---
LL_ARCHIVE_ROOT=/data/leadlag/archive
LL_SYMBOLS_CACHE=/data/leadlag/exchangeinfo.json

# --- read-only Binance key (M4: commissionRate only). IP-whitelisted to the EIP.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
