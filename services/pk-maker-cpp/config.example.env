# pk-maker-cpp settings. Copy to /etc/pkm.env (chmod 600) for systemd, or pass
# `pkm --env FILE <command>`. The process environment wins over the file.

# --- live guard -----------------------------------------------------------------
# `pkm run` places real orders; it refuses to start without this.
PKM_LIVE_CONFIRM=no

# --- wallet: a Polymarket deposit wallet ------------------------------------------
# The signing key (or POLY_PRIVATE_KEY_FILE=/path, one line of hex).
POLY_PRIVATE_KEY=
# The deposit wallet polymarket.com created for the account (holds pUSD and the
# approvals). pkm signs for it (EIP-1271); only signature type 3 is supported.
POLY_FUNDER=
POLY_SIGNATURE_TYPE=3
# CLOB API credentials; derived from the key at start when empty.
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=
# Relayer key (polymarket.com -> Settings -> API Keys): redeems settled winners
# gaslessly. Without it nothing is redeemed and pUSD stays locked in winners.
POLY_RELAYER_API_KEY=
# The address that owns the relayer key; the signer's when empty.
POLY_RELAYER_API_KEY_ADDRESS=

# --- Kalshi (read-only market data; the signal) ----------------------------------
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/poly-kalshi.pem

# --- endpoints (defaults shown) ---------------------------------------------------
# POLY_CLOB_URL=https://clob.polymarket.com
# POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# POLY_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com
# KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# KALSHI_REST_URL=https://api.elections.kalshi.com/trade-api/v2

# --- strategy: pk-polymaker's rule, same names and defaults ------------------------
PK_PM_ASSETS=BTC,ETH,SOL,XRP,BNB,HYPE,ZEC
PK_PM_HALF_SPREAD=0.02
PK_PM_SHARES=5
PK_PM_MIN_SHARES=5
PK_PM_MAX_NET=20
PK_PM_SKEW_K=0.01
PK_PM_PAUSE_JUMP=0.02
PK_PM_PAUSE_MS=1500
PK_PM_MAX_KALSHI_SPREAD=0.02
PK_PM_KALSHI_MAX_AGE_MS=10000
PK_PM_MIN_PX=0.05
PK_PM_MAX_PX=0.95
PK_PM_ENTRY_EARLY_S=20
PK_PM_STOP_S=60
PK_PM_REQUOTE_CENTS=1
PK_PM_MIN_REQUOTE_MS=300
PK_PM_ADVERSE_MS=200
PK_PM_REJECT_COOLDOWN_MS=500
PK_PM_MAX_ORDERS_PER_S=8
PK_PM_DAILY_LOSS_USD=15
PK_PM_MAX_OPEN_COST_USD=60
PK_PM_PAIR_MARGIN=0.02
PK_PM_OPEN_LEG_S=300
PK_PM_OPEN_MIN_FAIR=0.15
PK_PM_OPEN_MAX_FAIR=0.85
# First legs only on a side priced at least this (longshots lost, 10-27 review).
PK_PM_OPEN_MIN_PX=0.35
# A resting first-leg bid is pulled at once once its side's fair is within this.
PK_PM_OPEN_MIN_EDGE=0.01
# Half-spread of pairing bids (the pair guard still caps the pair under $1).
PK_PM_PAIR_HALF_SPREAD=0.01
PK_PM_FEED_STALE_MS=5000
PK_PM_RECONCILE_S=30

# --- process ------------------------------------------------------------------------
PKM_STATE_DIR=data/state
PKM_KILL_FILE=data/KILL
# Cores for the busy-polling hot thread and the pre-signer; -1 leaves them unpinned.
PKM_HOT_CORE=2
PKM_SIGNER_CORE=3
# Warm order connections (one request in flight each).
PKM_ORDER_CHANNELS=8
# A pre-signed order is used only while younger than this.
PKM_PRESIGN_TTL_MS=5000
# Fill backstop poll (the user channel is the primary source).
PKM_FILLS_POLL_MS=2000
PKM_POLY_SILENCE_MS=30000
