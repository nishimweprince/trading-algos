# /etc/jito-arb/jito-arb.env (root:root 0600). Read by every jito-arb unit.
# Helius API key: LaserStream x-token and RPC (https://mainnet.helius-rpc.com/?api-key=...).
HELIUS_API_KEY=
# LaserStream gRPC endpoint for Frankfurt from the Helius dashboard, e.g. https://laserstream-mainnet-fra.helius-rpc.com
LASERSTREAM_ENDPOINT=
