# Forex profile — copy to .env (default) or .env.forex (--profile forex)
# Start the paired mt5-trader instance first:
#   Copy-Item .env.example.forex .env   (in mt5-trader)  ->  mt5-signal-service
#   Copy-Item .env.example.forex .env   (here)           ->  ipda

# --- Market-data endpoint (polled for 1-minute candles) ---
DATA_API_URL=http://127.0.0.1:8000/v1/market-data/candles
DATA_API_KEY=replace-with-mt5-trader-API_KEY

# Single instrument (legacy). Omit when using SYMBOLS_FILE below.
QUOTE=EURUSD
DATA_LOOKBACK=600
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10

POLL_INTERVAL_SECONDS=15

# --- Timeframe / aggregation ---
TARGET_TF_MINUTES=3
BUCKET_OFFSET_MINUTES=0

# --- Entry trigger: Reversal "Buy Chance" / "Sell Chance" (file.txt Section 11) ---
# BUY  when RSI(REVERSAL_SENSITIVITY) crosses UP through REVERSAL_OVERSOLD
# SELL when RSI(REVERSAL_SENSITIVITY) crosses DOWN through REVERSAL_OVERBOUGHT
# REVERSAL_SENSITIVITY is the Pine "Reversals Sensitivity" input.
REVERSAL_SENSITIVITY=14
REVERSAL_OVERSOLD=25
REVERSAL_OVERBOUGHT=75

# --- Supertrend entry (file.txt Section 5) — NOT the live trigger ---
# Kept at the Pine defaults. These values are unused unless the service is
# switched back to the supertrend strategy in code.
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
# Must stay true: RSI gives no price level, so SL/TP are fixed pip distances.
USE_HARD_TARGETS=true
STOP_LOSS_PIPS=40
TAKE_PROFIT_PIPS=50

# Price movement of one pip, in quote units. SET THIS EXPLICITLY.
# EURUSD: PIP_SIZE=0.0001
# XAUUSD: PIP_SIZE=0.10, PRICE_DIGITS=3, QUOTE=XAUUSD, MT5_SYMBOL=XAUUSD
PIP_SIZE=0.0001
PRICE_DIGITS=5

# --- Trading sessions ---
# Signals outside these windows are logged and notified, never executed.
# Windows are exchange-local, so DST is handled by the tz database.
# Leave TRADING_SESSIONS empty to trade around the clock.
TRADING_SESSIONS=tokyo,new_york
SESSION_TOKYO=Asia/Tokyo:09:00-18:00
SESSION_NEW_YORK=America/New_York:08:00-17:00

# --- Notifications (notification-service) ---
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30

# --- Break-even advisory (notification only; no stop is modified) ---
TRACK_OPEN_TRADES=true
MFE_BREAK_EVEN_PIPS=30
TRACKED_TRADE_TTL_HOURS=24

# --- Order fields sent to mt5-trader ---
MT5_SYMBOL=EURUSD
VOLUME=0.10
DEVIATION_POINTS=
IGNORE_SIGNAL_AGE=true

# --- mt5-trader connection ---
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=replace-with-mt5-trader-API_KEY
MT5_TIMEOUT_SECONDS=10
REQUIRE_READY=true

# --- Runtime ---
LOG_LEVEL=INFO
LOGS_DIR=logs/forex
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# --- Multi-instrument (optional) ---
# SYMBOLS_FILE=symbols.forex.json
