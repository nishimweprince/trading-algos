# Forex profile — copy to .env (default) or .env.forex (--profile forex)
# Start the paired mt5-trader instance first:
#   Copy-Item .env.example.forex .env   (in mt5-trader)  ->  mt5-signal-service
#   Copy-Item .env.example.forex .env   (here)           ->  ipda

# --- Market-data endpoint (polled for 1-minute candles) ---
DATA_API_URL=http://127.0.0.1:8000/v1/market-data/candles
DATA_API_KEY=replace-with-mt5-trader-API_KEY

# Single instrument (legacy). Omit when using SYMBOLS_FILE below.
QUOTE=EURUSD
DATA_LOOKBACK=600
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10

POLL_INTERVAL_SECONDS=15

# --- Timeframe / aggregation ---
TARGET_TF_MINUTES=3
BUCKET_OFFSET_MINUTES=0

# --- Strategy (IPDA Supertrend entry; defaults match file.txt Section 5) ---
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
USE_HARD_TARGETS=true
STOP_LOSS_PIPS=25
TAKE_PROFIT_PIPS=40

# Price movement of one pip, in quote units. SET THIS EXPLICITLY.
# EURUSD: PIP_SIZE=0.0001
# XAUUSD: PIP_SIZE=0.10, PRICE_DIGITS=3, QUOTE=XAUUSD, MT5_SYMBOL=XAUUSD
PIP_SIZE=0.0001
PRICE_DIGITS=5

# --- Order fields sent to mt5-trader ---
MT5_SYMBOL=EURUSD
VOLUME=0.10
DEVIATION_POINTS=
IGNORE_SIGNAL_AGE=true

# --- mt5-trader connection ---
MT5_SIGNAL_API_URL=http://127.0.0.1:8000
MT5_SIGNAL_API_KEY=replace-with-mt5-trader-API_KEY
MT5_TIMEOUT_SECONDS=10
REQUIRE_READY=true

# --- Runtime ---
LOG_LEVEL=INFO
LOGS_DIR=logs/forex
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# --- Multi-instrument (optional) ---
# SYMBOLS_FILE=symbols.forex.json
