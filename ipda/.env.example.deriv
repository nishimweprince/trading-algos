# Deriv DMT5 / synthetic indices profile — copy to .env.deriv and run with --profile deriv
# Start the paired mt5-trader instance first:
#   Copy-Item .env.example.deriv .env.deriv   (in mt5-trader)  ->  mt5-signal-service --profile deriv
#   Copy-Item .env.example.deriv .env.deriv   (here)           ->  ipda --profile deriv

# --- Market-data endpoint (polled for 1-minute candles) ---
DATA_API_URL=http://127.0.0.1:8001/v1/market-data/candles
DATA_API_KEY=replace-with-mt5-trader-API_KEY

QUOTE=Volatility 75 Index
DATA_LOOKBACK=600
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10

POLL_INTERVAL_SECONDS=15

TARGET_TF_MINUTES=5
BUCKET_OFFSET_MINUTES=0

# --- Entry trigger: Reversal "Buy Chance" / "Sell Chance" (file.txt Section 11) ---
REVERSAL_SENSITIVITY=14
REVERSAL_OVERSOLD=25
REVERSAL_OVERBOUGHT=75

# --- Supertrend entry (file.txt Section 5) — NOT the live trigger ---
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
# Must stay true: RSI gives no price level, so SL/TP are fixed pip distances.
USE_HARD_TARGETS=true
# Deliberately wider than the forex profile's 40/50. At PIP_SIZE=0.01 a 40-pip stop
# is a 0.40 price distance on Volatility 75 — well inside the symbol's
# trade_stops_level — and mt5-trader rejects it with stop_loss_too_close.
STOP_LOSS_PIPS=50
TAKE_PROFIT_PIPS=80

PIP_SIZE=0.01
PRICE_DIGITS=2

# --- Trading sessions ---
# Empty: synthetic indices trade continuously, so NY/Tokyo cash sessions are
# meaningless here. Set to tokyo,new_york to gate this profile as well.
TRADING_SESSIONS=

# --- Notifications (notification-service) ---
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30

# --- Break-even advisory (notification only; no stop is modified) ---
TRACK_OPEN_TRADES=true
MFE_BREAK_EVEN_PIPS=30
TRACKED_TRADE_TTL_HOURS=24

MT5_SYMBOL=Volatility 75 Index
VOLUME=0.10
DEVIATION_POINTS=50
IGNORE_SIGNAL_AGE=true

MT5_SIGNAL_API_URL=http://127.0.0.1:8001
MT5_SIGNAL_API_KEY=replace-with-mt5-trader-API_KEY
MT5_TIMEOUT_SECONDS=10
REQUIRE_READY=true

LOG_LEVEL=INFO
LOGS_DIR=logs/deriv
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500

# SYMBOLS_FILE=symbols.deriv.json
