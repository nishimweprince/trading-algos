# FTMO gold profile. Copy to .env.ftmo and run IPDA with --profile ftmo.
DATA_API_URL=http://127.0.0.1:8001/v1/market-data/candles
DATA_API_KEY=replace-with-ftmo-execution-service-api-key
SYMBOLS_FILE=symbols.ftmo.json
DATA_LOOKBACK=600
DATA_QUOTE_PARAM=quote
DATA_COUNT_PARAM=count
DATA_TIMEOUT_SECONDS=10
POLL_INTERVAL_SECONDS=15

TARGET_TF_MINUTES=3
BUCKET_OFFSET_MINUTES=0
REVERSAL_SENSITIVITY=14
REVERSAL_OVERSOLD=25
REVERSAL_OVERBOUGHT=75
SUPERTREND_SENSITIVITY=5.5
SUPERTREND_ATR_LEN=11
SMA_LEN=13
RISK_REWARD=2.0
SEND_STOP_LOSS=true
SEND_TAKE_PROFIT=true
USE_HARD_TARGETS=true
# Legacy fallbacks remain required by Settings; symbols.ftmo.json overrides them per symbol.
PIP_SIZE=0.1
PRICE_DIGITS=3
VOLUME=0.01

TRADING_SESSIONS=tokyo,new_york
SESSION_TOKYO=Asia/Tokyo:09:00-18:00
SESSION_NEW_YORK=America/New_York:08:00-17:00

NOTIFICATIONS_ENABLED=true
NOTIFICATION_SERVICE_URL=https://notifications.nishimweprince.dev
NOTIFICATION_API_KEY=replace-with-notification-service-api-key
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30
TRACK_OPEN_TRADES=true
MFE_BREAK_EVEN_PIPS=30
TRACKED_TRADE_TTL_HOURS=24

IGNORE_SIGNAL_AGE=true
MT5_SIGNAL_API_URL=http://127.0.0.1:8001
MT5_SIGNAL_API_KEY=replace-with-ftmo-execution-service-api-key
MT5_TIMEOUT_SECONDS=10
REQUIRE_READY=true

LOG_LEVEL=INFO
LOGS_DIR=logs/ftmo
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
