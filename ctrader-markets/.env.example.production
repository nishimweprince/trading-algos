# One production gateway owns the OAuth token and all enabled cTrader accounts.
CTRADER_CLIENT_ID=replace-with-client-id
CTRADER_CLIENT_SECRET=replace-with-client-secret
CTRADER_ACCESS_TOKEN=replace-with-access-token
CTRADER_REFRESH_TOKEN=replace-with-refresh-token

ACCOUNTS_CONFIG_PATH=data/accounts.production.toml
DEFAULT_MARKET_DATA_ACCOUNT=forex_demo

# Shared caller authentication. Keep the service bound to loopback.
API_KEY=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=8010

# Fail-closed execution switches. Demo execution needs TRADING_ENABLED=true.
# Live accounts additionally require LIVE_TRADING_ENABLED=true.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
MAX_VOLUME_LOTS=replace-with-maximum-volume
ALLOWED_ORDER_SOURCES=replace-with-source-slugs
SIGNAL_MAX_AGE_SECONDS=60
FUTURE_TOLERANCE_SECONDS=5
EXECUTION_RESPONSE_TIMEOUT_SECONDS=10

MAX_CANDLES_LOOKBACK=5000
HEARTBEAT_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
CONNECT_TIMEOUT_SECONDS=15
RECONNECT_INITIAL_BACKOFF_SECONDS=1
RECONNECT_MAX_BACKOFF_SECONDS=60
RECONNECT_STABILITY_SECONDS=30
STARTUP_READY_TIMEOUT_SECONDS=30
SUBSCRIBER_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=15
TICK_STALENESS_SECONDS=60
HISTORICAL_REQUESTS_PER_SECOND=4
NON_HISTORICAL_REQUESTS_PER_SECOND=45

TOKEN_CACHE_PATH=data/token-cache.production.json
EXECUTION_DATABASE_PATH=data/executions.production.sqlite3
EVENTS_LOG_PATH=logs/events.production.jsonl
LOG_LEVEL=INFO
