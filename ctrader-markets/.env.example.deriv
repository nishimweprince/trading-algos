# Deriv profile — copy to .env.deriv and run with --profile deriv
#
# This profile targets a Deriv cTrader account. Register the application at
# https://openapi.ctrader.com/ and obtain tokens via the OAuth flow in README.md.
CTRADER_CLIENT_ID=replace-with-openapi-client-id
CTRADER_CLIENT_SECRET=replace-with-openapi-client-secret
CTRADER_ACCESS_TOKEN=replace-with-oauth-access-token
CTRADER_REFRESH_TOKEN=replace-with-oauth-refresh-token

# Find it with: ctrader-markets --profile deriv --discover-accounts
CTRADER_ACCOUNT_ID=1

CTRADER_ENVIRONMENT=demo

API_KEY=replace-with-a-long-random-secret

# Must differ from every other profile on the same host.
HOST=127.0.0.1
PORT=8011

# IMPORTANT: do NOT copy symbol names from mt5-trader/.env.example.deriv. Those
# are Deriv's MT5 synthetic indices ("Volatility 75 Index", "Boom 500 Index")
# and will not resolve on a cTrader broker. Run
#   ctrader-markets --profile deriv --discover-symbols
# and paste the exact symbolName values it prints.
SYMBOLS=EURUSD

LIVE_TRENDBAR_PERIODS=M1

MAX_CANDLES_LOOKBACK=5000

HEARTBEAT_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
RECONNECT_INITIAL_BACKOFF_SECONDS=1
RECONNECT_MAX_BACKOFF_SECONDS=60

SUBSCRIBER_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=15
TICK_STALENESS_SECONDS=60
HISTORICAL_REQUESTS_PER_SECOND=4

TOKEN_CACHE_PATH=data/token-cache.deriv.json
EVENTS_LOG_PATH=logs/events.deriv.jsonl

LOG_LEVEL=INFO
