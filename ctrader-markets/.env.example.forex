# Forex / majors profile — copy to .env (default) or .env.forex (--profile forex)
#
# CTRADER_CLIENT_ID / CTRADER_CLIENT_SECRET come from registering an application
# at https://openapi.ctrader.com/. The access and refresh tokens come from the
# one-time browser OAuth flow documented in README.md.
CTRADER_CLIENT_ID=replace-with-openapi-client-id
CTRADER_CLIENT_SECRET=replace-with-openapi-client-secret
CTRADER_ACCESS_TOKEN=replace-with-oauth-access-token
CTRADER_REFRESH_TOKEN=replace-with-oauth-refresh-token

# The numeric ctidTraderAccountId, NOT your account login number.
# Find it with: ctrader-markets --profile forex --discover-accounts
CTRADER_ACCOUNT_ID=1

# demo and live are fully separated connections and cannot be mixed.
CTRADER_ENVIRONMENT=demo

# API authentication (use a high-entropy value of at least 16 characters)
API_KEY=replace-with-a-long-random-secret

# Bind address. Give each profile its own port.
HOST=127.0.0.1
PORT=8010

# Exact, case-sensitive cTrader symbol names. Startup fails closed if any of
# these cannot be resolved. List them with:
#   ctrader-markets --profile forex --discover-symbols
SYMBOLS=EURUSD,GBPUSD,XAUUSD

# Optional live trendbar subscriptions, in addition to spot ticks.
# Supported: M1 M2 M3 M4 M5 M10 M15 M30 H1 H4 H12 D1 W1  (MN1 is not supported)
LIVE_TRENDBAR_PERIODS=M1

# Cap on requested bar lookback for GET /v1/market-data/candles
MAX_CANDLES_LOOKBACK=5000

# Connection tuning. HEARTBEAT_INTERVAL_SECONDS must stay under 10 — the broker
# drops connections that go silent for longer.
HEARTBEAT_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
RECONNECT_INITIAL_BACKOFF_SECONDS=1
RECONNECT_MAX_BACKOFF_SECONDS=60

# Per-SSE-subscriber buffer. On overflow the oldest tick is dropped, because a
# newer quote supersedes a stale one.
SUBSCRIBER_QUEUE_SIZE=256
SSE_KEEPALIVE_SECONDS=15

# /health/ready reports not_ready when the newest tick is older than this.
TICK_STALENESS_SECONDS=60

# cTrader allows 5 historical requests/second per connection.
HISTORICAL_REQUESTS_PER_SECOND=4

# Rotated OAuth tokens are persisted here. Losing this file means redoing the
# browser OAuth flow. Keep it out of git; use a per-profile path.
TOKEN_CACHE_PATH=data/token-cache.forex.json
EVENTS_LOG_PATH=logs/events.forex.jsonl

LOG_LEVEL=INFO
