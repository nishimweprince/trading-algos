# Copy to .env before `session-hedging`.

# ctrader-markets gateway (required for seed, paper, and source=ctrader backtests).
# CTRADER_API_KEY must match the running gateway's API_KEY
# (production on :8010 → ctrader-markets/.env.production).
CTRADER_MARKETS_URL=http://127.0.0.1:8010
CTRADER_API_KEY=replace-with-ctrader-markets-api-key

# Optional auth on this service. Leave empty to disable.
API_KEY=

HOST=0.0.0.0
PORT=8012
LOG_LEVEL=INFO

SYMBOL=XAUUSD
PIP_SIZE=0.1
# Phase 2 entry structure: hedge_pair, synthetic_breakout, contingent_hedge, or oco_bracket.
ENTRY_MODE=hedge_pair
TP_MODE=fixed_r
# Used only when TP_MODE=partial_trail. Frozen Phase 3 closes 50% at 1R, runner at RR.
PARTIAL_TP_R=1.0
PARTIAL_FRACTION=0.5
LOCK_MODE=absolute
# Used only when LOCK_MODE=r_relative. Frozen Phase 3 coordinates use 0.1 or 0.2.
LOCK_R=0
# contingent_hedge only. failure_zone is the only defined Phase 2 trigger.
HEDGE_RATIO_INITIAL=0
HEDGE_TRIGGER_MODE=failure_zone
HEDGE_FAILURE_K=0.5
HEDGE_RATIO_STAGED=1
# oco_bracket only. orb_frac multiplies the measured opening range; fixed_pips uses PIP_SIZE.
OCO_BUFFER_MODE=orb_frac
OCO_BUFFER_VALUE=0.10
OCO_EXPIRY_BARS=4
# At most one fresh, tagged bracket may be staged after the initial filled bracket closes.
ALLOW_REENTRY=false
# Broker contract multiplier for the legacy price-delta series. Never inferred from PIP_SIZE.
POINT_VALUE=1
LOCK_PIPS=20
# bar_range: S = SL_MULT × opening range over ORB_MINUTES.
# fixed_pips: S = FIXED_STOP_PIPS, independent of the range (R is then constant across sessions).
# atr14: S = SL_MULT × Wilder ATR(14) of completed parent bars.
# orb_atr14_blend: S = SL_MULT × (0.5 × opening range + 0.5 × ATR14).
STOP_MODE=bar_range
SL_MULT=2
# Required only when STOP_MODE=fixed_pips.
FIXED_STOP_PIPS=0
RR=3
MIN_STOP_PIPS=0
# 0 disables the cost-derived floor. Phase 3 coordinates use 2 or 3 times per-side all-in
# execution cost (spread + slippage + commission) as MIN_STOP_PIPS.
MIN_STOP_COST_MULT=0
# Single-topic Phase 3 filters. Default off; frozen coordinates enable exactly one.
FILTER_D1_EMA50=false
FILTER_NR7=false
FILTER_ORB_ATR_MIN=0
FILTER_ORB_ATR_MAX=0
QTY=1
SKIP_DOJI=true
INITIAL_CAPITAL=100000
# Pips versus dollars is chosen in the UI, per run, not here. Selecting dollars asks for a
# dollar-per-pip rate at QTY=1, defaulting to 10.

# Phase 1 costs are pips per transaction side. Defaults are zero for exact Phase 0 parity.
COST_MODEL=per_session
SPREAD_PIPS_PER_SIDE=0
SLIPPAGE_PIPS_PER_SIDE=0
COMMISSION_PIPS_PER_SIDE=0
SWAP_LONG_PIPS_PER_ROLLOVER=0
SWAP_SHORT_PIPS_PER_ROLLOVER=0
SWAP_ROLLOVER_TIME=17:00
SWAP_TIMEZONE=America/New_York
SWAP_TRIPLE_WEEKDAY=wednesday
# JSON mapping from session name to partial numeric cost overrides.
SESSION_COST_OVERRIDES={}
BREAKEVEN_COST_REPORT=true

# fixed_qty preserves QTY. fixed_fractional sizes in cash at the UI's dollar-per-pip rate
# (default 10), because sizing needs cash whatever unit results are displayed in.
RISK_MODE=fixed_qty
RISK_PCT_PER_R=0.10
MAX_PAIR_RISK_PCT=0.20
MAX_OPEN_RISK_PCT=0.75
MAX_CONCURRENT_STRUCTURES=3
ONE_OPEN_PER_SESSION=true
CONTRACT_SIZE=100

# PropGuard is disabled for parity. custom sizes in cash at the UI's dollar-per-pip rate.
FIRM_PROFILE=none
# Defaults to INITIAL_CAPITAL when omitted.
# FIRM_INITIAL_BALANCE=100000
FIRM_DAILY_LOSS_LIMIT_PCT=5
FIRM_TOTAL_LOSS_LIMIT_PCT=10
FIRM_TIMEZONE=America/New_York
FIRM_DAILY_RESET_TIME=00:00
FIRM_BREACH_ACTION=block_new

TIME_EXIT_MODE=max_age
MAX_AGE_HOURS=24

TRADING_SESSIONS=tokyo,london,new_york
SESSION_TOKYO=Asia/Tokyo:09:00-18:00
SESSION_LONDON=Europe/London:08:00-16:30
SESSION_NEW_YORK=America/New_York:08:00-17:00
# TIMEFRAME is bar resolution only. Opening range and entry lag are independent.
# TIMEFRAME=M15
ORB_MINUTES=60
ENTRY_DELAY_MINUTES=15
ANCHOR_TOLERANCE_MINUTES=15
INTRABAR_MODE=m1_conservative
# Optional explicit anchors (name:TZ:HH:MM). Empty = each session window's start.
# SESSION_ANCHORS=tokyo:Asia/Tokyo:09:00,london:Europe/London:08:00,new_york:America/New_York:08:00

PAPER_ENABLED=true
POLL_INTERVAL_SECONDS=15
PAPER_LOOKBACK=200

DATA_DIR=data
LOGS_DIR=logs

# Optional paper notifications (ipda/mt5-trader contract). Off by default.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3010
NOTIFICATION_API_KEY=
NOTIFICATION_CHANNELS=TELEGRAM
NOTIFICATION_TIMEOUT_SECONDS=30
