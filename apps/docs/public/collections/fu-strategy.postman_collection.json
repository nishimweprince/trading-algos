{
  "info": {
    "name": "Trading Algos — FU Strategy",
    "description": "All FU Strategy endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "symbol",
      "value": "GOLD",
      "type": "string"
    },
    {
      "key": "notificationId",
      "value": "replace-with-notification-id",
      "type": "string"
    },
    {
      "key": "notificationRecipient",
      "value": "",
      "type": "string",
      "description": "Sensitive. Phone number or recipient supported by the configured channel."
    },
    {
      "key": "whatsappVerifyToken",
      "value": "",
      "type": "string",
      "description": "Sensitive. WhatsApp webhook verification token."
    },
    {
      "key": "whatsappSignature",
      "value": "",
      "type": "string",
      "description": "Sensitive. Computed sha256 webhook signature."
    },
    {
      "key": "tradingviewWebhookToken",
      "value": "",
      "type": "string",
      "description": "Sensitive. TradingView webhook token."
    },
    {
      "key": "webhookChallenge",
      "value": "postman-challenge",
      "type": "string"
    },
    {
      "key": "enableStateChangingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for requests that place orders, send messages, control processes, or write data."
    },
    {
      "key": "enableStreamingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for long-lived SSE requests."
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "GET /"
          }
        },
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "GET /health"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications?limit=100",
            "description": "GET /notifications?limit=100"
          }
        },
        {
          "name": "Get notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}",
            "description": "GET /notifications/{{notificationId}}"
          }
        },
        {
          "name": "Send test notification",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStateChangingRequests') !== 'true') {",
                  "  console.warn('Request skipped: set collection variable enableStateChangingRequests=true to send state-changing requests.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/notifications/test",
            "description": "POST /notifications/test",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"{{notificationRecipient}}\",\n  \"message\": \"Postman endpoint test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Broadcast test notification",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStateChangingRequests') !== 'true') {",
                  "  console.warn('Request skipped: set collection variable enableStateChangingRequests=true to send state-changing requests.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,400,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/notifications/test/broadcast",
            "description": "POST /notifications/test/broadcast",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Postman endpoint test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Verify WhatsApp webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,403]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response Content-Type is text/plain', () => {",
                  "  if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('text/plain');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token={{whatsappVerifyToken}}&hub.challenge={{webhookChallenge}}",
            "description": "GET /webhooks/whatsapp?hub.mode=subscribe&hub.verify_token={{whatsappVerifyToken}}&hub.challenge={{webhookChallenge}}"
          }
        },
        {
          "name": "Receive WhatsApp webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStateChangingRequests') !== 'true') {",
                  "  console.warn('Request skipped: set collection variable enableStateChangingRequests=true to send state-changing requests.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,401]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Hub-Signature-256",
                "value": "{{whatsappSignature}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/whatsapp",
            "description": "POST /webhooks/whatsapp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Receive TradingView webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStateChangingRequests') !== 'true') {",
                  "  console.warn('Request skipped: set collection variable enableStateChangingRequests=true to send state-changing requests.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,403]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/tradingview?token={{tradingviewWebhookToken}}",
            "description": "POST /webhooks/tradingview?token={{tradingviewWebhookToken}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"timeframe\": \"1m\",\n  \"signal\": \"Bullish reversal\",\n  \"price\": 2000,\n  \"indicator\": \"Postman endpoint test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
