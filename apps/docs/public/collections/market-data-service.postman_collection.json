{
  "info": {
    "name": "Trading Algos — Market Data Service",
    "description": "All market-data-service endpoints. Set market to forex, deriv or crypto as served by the profile behind baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8020",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "Sensitive. Market data service API key."
    },
    {
      "key": "market",
      "value": "forex",
      "type": "string"
    },
    {
      "key": "symbol",
      "value": "XAUUSD",
      "type": "string"
    },
    {
      "key": "timeframe",
      "value": "M15",
      "type": "string"
    },
    {
      "key": "enableStateChangingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for requests that place orders, send messages, control processes, or write data."
    },
    {
      "key": "enableStreamingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for long-lived SSE requests."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "GET /health/live"
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "GET /health/ready"
          }
        }
      ]
    },
    {
      "name": "Market data",
      "item": [
        {
          "name": "Tick",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,422,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/{{market}}/tick?symbol={{symbol}}",
            "description": "GET /v1/{{market}}/tick?symbol={{symbol}}"
          }
        },
        {
          "name": "Candles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,422,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/{{market}}/candles?symbol={{symbol}}&timeframe={{timeframe}}&count=100",
            "description": "GET /v1/{{market}}/candles?symbol={{symbol}}&timeframe={{timeframe}}&count=100"
          }
        },
        {
          "name": "Symbols",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/{{market}}/symbols",
            "description": "GET /v1/{{market}}/symbols"
          }
        },
        {
          "name": "Capabilities",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/{{market}}/capabilities",
            "description": "GET /v1/{{market}}/capabilities"
          }
        },
        {
          "name": "Tick stream",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStreamingRequests') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response Content-Type is text/event-stream', () => {",
                  "  if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('text/event-stream');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/{{market}}/stream/ticks?symbols={{symbol}}",
            "description": "GET /v1/{{market}}/stream/ticks?symbols={{symbol}}"
          }
        }
      ]
    }
  ]
}
