{
  "info": {
    "name": "Trading Algos — Backtesting Service",
    "description": "All backtesting-service endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8012",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "Sensitive. Optional backtesting API key."
    },
    {
      "key": "symbol",
      "value": "XAUUSD",
      "type": "string"
    },
    {
      "key": "timeframe",
      "value": "M15",
      "type": "string"
    },
    {
      "key": "source",
      "value": "local",
      "type": "string"
    },
    {
      "key": "enableStateChangingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for requests that place orders, send messages, control processes, or write data."
    },
    {
      "key": "enableStreamingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for long-lived SSE requests."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "GET /health/live"
          }
        },
        {
