{
  "info": {
    "name": "Trading Algos — MT5 Trader (Frozen)",
    "description": "All endpoints on the frozen pre-cutover MT5 service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "Sensitive. MT5 service API key."
    },
    {
      "key": "symbol",
      "value": "XAUUSD",
      "type": "string"
    },
    {
      "key": "timeframe",
      "value": "M1",
      "type": "string"
    },
    {
      "key": "signalSource",
      "value": "ipda",
      "type": "string"
    },
    {
      "key": "signalId",
      "value": "00000000-0000-0000-0000-000000000002",
      "type": "string"
    },
    {
      "key": "enableStateChangingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for requests that place orders, send messages, control processes, or write data."
    },
    {
      "key": "enableStreamingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for long-lived SSE requests."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "GET /health/live"
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "GET /health/ready"
          }
        }
      ]
    },
    {
      "name": "Signals",
      "item": [
        {
          "name": "Submit signal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStateChangingRequests') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});",
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body[\"signal_id\"]) pm.collectionVariables.set(\"signalId\", body[\"signal_id\"]);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/signals",
            "description": "POST /v1/signals",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signal_id\": \"{{$guid}}\",\n  \"occurred_at\": \"{{$isoTimestamp}}\",\n  \"execution_type\": \"market\",\n  \"symbol\": \"{{symbol}}\",\n  \"direction\": \"buy\",\n  \"volume\": \"0.01\",\n  \"stop_loss_distance\": \"10\",\n  \"take_profit_distance\": \"20\",\n  \"source\": \"{{signalSource}}\",\n  \"ignore_signal_age\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Signal status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/signals/{{signalId}}",
            "description": "GET /v1/signals/{{signalId}}"
          }
        }
      ]
    },
    {
      "name": "Market data",
      "item": [
        {
          "name": "Candles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/market-data/candles?quote={{symbol}}&timeframe={{timeframe}}&count=100",
            "description": "GET /v1/market-data/candles?quote={{symbol}}&timeframe={{timeframe}}&count=100"
          }
        },
        {
          "name": "Tick",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is expected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,503]);",
                  "});",
                  "pm.test('Response time is below 5 seconds', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response is JSON when it has a body', () => {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "    pm.response.json();",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/market-data/tick?quote={{symbol}}",
            "description": "GET /v1/market-data/tick?quote={{symbol}}"
          }
        }
      ]
    }
  ]
}
