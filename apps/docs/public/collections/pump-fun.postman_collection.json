{
  "info": {
    "name": "Trading Algos — Pump.fun Dashboard",
    "description": "All pump-fun dashboard API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{dashboardUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{dashboardPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "dashboardUsername",
      "value": "",
      "type": "string",
      "description": "Sensitive. Dashboard Basic Auth username."
    },
    {
      "key": "dashboardPassword",
      "value": "",
      "type": "string",
      "description": "Sensitive. Dashboard Basic Auth password."
    },
    {
      "key": "range",
      "value": "7d",
      "type": "string"
    },
    {
      "key": "track",
      "value": "live",
      "type": "string"
    },
    {
      "key": "enableStateChangingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for requests that place orders, send messages, control processes, or write data."
    },
    {
      "key": "enableStreamingRequests",
      "value": "false",
      "type": "string",
      "description": "Explicit opt-in for long-lived SSE requests."
    }
  ],
