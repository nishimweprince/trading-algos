[Unit]
Description=Callisto/Tickmind executor (trades through execution-service; holds no broker credentials)
After=network-online.target execution-service.service callisto-monitor.service
Wants=network-online.target

[Service]
UMask=0077
User=ec2-user
WorkingDirectory=/home/ec2-user/callisto
ExecStart=/home/ec2-user/callisto/.venv/bin/python executor.py run
Restart=always
RestartSec=30
Nice=5
MemoryMax=400M

[Install]
WantedBy=multi-user.target
