# --- source ---
CHANNEL=callistofx
# Only for `monitor.py --source telethon` (my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- OpenAI classifier ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING=low
MAX_IMAGES_PER_POST=4
MIN_CONFIDENCE=0.6
# Calls with a direction but no visible symbol are taken as this ticker (empty = drop)
DEFAULT_TICKER=XAUUSD

# --- grouping posts into one trade idea ---
GROUP_HOURS=6
ENTRY_MATCH_PIPS=100
PIP_XAUUSD=0.10

# --- trade management (pips from your fill) ---
SL_PIPS=120
TP_PIPS=150
# Trailing: once TRAIL_START_PIPS in profit, keep the stop TRAIL_DISTANCE_PIPS behind the
# best price, moving it in increments of at least TRAIL_STEP_PIPS. TRAIL_START_PIPS=0 = off.
# Defaults SL 120 / TP 150 / trail 50/30/10: the only region positive both on the month and
# out of sample (Oct 15-Nov 8) in RESULTS.md. t ~1, not proven.
TRAIL_START_PIPS=50
TRAIL_DISTANCE_PIPS=30
TRAIL_STEP_PIPS=10
MAX_HOLD_HOURS=24
ENTRY_DELAY_SECONDS=30
# Skip ideas already this many pips in profit when first seen (0 = take all)
MAX_AGE_PIPS=0
USD_PER_PIP_PER_LOT=10

# --- monitor outputs ---
POLL_SECONDS=15
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- cTrader execution (executor.py) ---
# Open API application credentials (openapi.ctrader.com -> Applications)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# OAuth pair for the trading account. The refresh token rotates on every refresh and the
# newest pair is kept in data/ctrader_tokens.json, so run the executor on ONE host only.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Broker login (resolved to the ctid account id), or set CTRADER_ACCOUNT_ID directly
CTRADER_ACCOUNT_NUMBER=
CTRADER_SYMBOLS={"XAUUSD": "XAUUSD"}
# Safety: both false = log-only. A live account (Spotware isLive) also needs LIVE_TRADING_ENABLED.
EXECUTION_ENABLED=false
LIVE_TRADING_ENABLED=false
LOTS=0.2
MAX_OPEN_POSITIONS=1
# Signals older than this when the executor sees them are skipped
MAX_SIGNAL_AGE_SECONDS=180
# Skip when price has already run this many pips past the channel's stated entry (0 = off)
MAX_ENTRY_SLIP_PIPS=80

# --- Tickmind source for the same executor (one cTrader connection for both) ---
# tickmind/watch_signals.py output; empty = Tickmind not traded
TICKMIND_EVENTS_PATH=
TICKMIND_EXECUTION_ENABLED=false
TICKMIND_LOTS=0.2
TICKMIND_MAX_OPEN_POSITIONS=1
# Skip signals older than this, or with price this far from Tickmind's entry
TICKMIND_MAX_SIGNAL_AGE_SECONDS=300
TICKMIND_MAX_ENTRY_SLIP_PIPS=50
# Close our position when Tickmind marks the signal closed
TICKMIND_FOLLOW_CLOSE=true
