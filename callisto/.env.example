# --- source ---
CHANNEL=callistofx
# Only for `monitor.py --source telethon` (my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- OpenAI classifier ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING=low
MAX_IMAGES_PER_POST=4
MIN_CONFIDENCE=0.6
# Calls with a direction but no visible symbol are taken as this ticker (empty = drop)
DEFAULT_TICKER=XAUUSD

# --- grouping posts into one trade idea ---
GROUP_HOURS=6
ENTRY_MATCH_PIPS=100
PIP_XAUUSD=0.10

# --- trade management (pips from your fill) ---
SL_PIPS=120
TP_PIPS=150
# Trailing: once TRAIL_START_PIPS in profit, keep the stop TRAIL_DISTANCE_PIPS behind the
# best price, moving it in increments of at least TRAIL_STEP_PIPS. TRAIL_START_PIPS=0 = off.
# Defaults SL 120 / TP 150 / trail 50/30/10: the only region positive both on the month and
# out of sample (Oct 15-Nov 8) in RESULTS.md. t ~1, not proven.
TRAIL_START_PIPS=50
TRAIL_DISTANCE_PIPS=30
TRAIL_STEP_PIPS=10
MAX_HOLD_HOURS=24
ENTRY_DELAY_SECONDS=30
# Skip ideas already this many pips in profit when first seen (0 = take all)
MAX_AGE_PIPS=0
USD_PER_PIP_PER_LOT=10

# --- monitor outputs ---
POLL_SECONDS=15
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
