    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.4",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
