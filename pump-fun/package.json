{
  "name": "pump-fun-scalper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated pump.fun post-graduation scalper. Defaults to paper trading. Not financial advice.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "prestart": "npm run dashboard:build",
    "start": "node --experimental-strip-types src/start.ts",
    "prestart:prod": "npm run dashboard:build",
    "start:prod": "node --experimental-strip-types src/index.ts",
    "start:bot": "node --experimental-strip-types src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop pump-desk",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "dashboard:server": "node --experimental-strip-types src/dashboard/standalone.ts",
    "dashboard:dev": "vite web/dashboard --host 127.0.0.1 --port 5173",
    "dashboard:build": "vite build web/dashboard",
    "dashboard:preview": "vite preview web/dashboard --host 127.0.0.1 --port 3600 --strictPort",
    "report:soak": "node --experimental-strip-types src/dashboard/report-cli.ts",
    "report:strategy": "REPORT_KIND=strategy node --experimental-strip-types src/dashboard/report-cli.ts --strategy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@hono/node-server": "^1.18.2",
    "@pump-fun/pump-swap-sdk": "^1.18.0",
    "@solana/web3.js": "^1.98.4",
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.4",
    "chart.js": "^4.5.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "hono": "^4.10.7",
    "preact": "^10.27.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@triton-one/yellowstone-grpc": ">=1.3.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.13.0",
    "vite": "^7.1.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
