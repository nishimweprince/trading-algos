# Copy to .env and fill in. NEVER commit .env.
# Secrets are loaded from here (or the OS environment) — never from config.yaml,
# never logged, never persisted to the DB.

# --- Wallet ---
# Base58-encoded secret key OR JSON array of bytes. Referenced by config.wallet.keypairEnvVar.
# Leave blank in paper/dry-run mode; required only for live mode.
WALLET_PRIVATE_KEY=

# --- Telegram alerts ---
# Referenced by config.alerts.telegramBotTokenEnvVar. Leave blank to disable alerts.
TG_BOT_TOKEN=

# --- RPC / streaming providers (used from Phase 1 onward) ---
# These are read via ${ENV_VAR} interpolation in config.yaml. Optional until detection lands.
HELIUS_HTTP_URL=
HELIUS_GRPC_URL=
HELIUS_GRPC_TOKEN=
SECONDARY_HTTP_URL=
JITO_BLOCK_ENGINE_URL=
RUGCHECK_API_KEY=
