# Copy to .env and fill in. NEVER commit .env.
# Secrets are loaded from here (or the OS environment) — never from config.yaml,
# never logged, never persisted to the DB.

# --- Wallet ---
# Base58-encoded secret key OR JSON array of bytes. Referenced by config.wallet.keypairEnvVar.
# Required in live. Base58 secret key OR JSON byte array.
WALLET_PRIVATE_KEY=

# Read-only wallet identity for racer paper sizing (config.racer.walletPubkeyEnvVar).
# The racer only reads this address's balance to size paper tracks — it never
# signs with it and never sends. Blank falls back to the WALLET_PRIVATE_KEY
# pubkey when set, else to the fixed paper size (flagged, never silent).
RACER_WALLET_PUBKEY=

# --- Position sizing / live risk ---
# No longer read: since the 1 SOL live pilot (2026-09-16) the size rungs and
# the daily-loss cap are explicit percents in config.yaml (entry.* / risk.*).
# Kept so older .env files still load; safe to delete.
LIVE_RISK_WALLET_PCT=5

# --- Telegram alerts ---
# Referenced by config.alerts.telegramBotTokenEnvVar. Leave blank to disable alerts.
TG_BOT_TOKEN=

# --- RPC / streaming providers (used from Phase 1 onward) ---
# These are read via ${ENV_VAR} interpolation in config.yaml. Optional until detection lands.

# Helius mainnet primary (key in URL, needs no headers). Serves HTTP reads,
# the WS detection feed (wss:// derived from this automatically), DAS
# getAsset, and execution. MUST be https://.
# Atlas transactionSubscribe (detection with no getTransaction round trip)
# needs a paid plan; below that the feed silently falls back to logsSubscribe.
# Devnet: https://devnet.helius-rpc.com/?api-key=<KEY>
HELIUS_HTTP_URL=

# Devnet Helius HTTP endpoint (key in URL). Used ONLY by config.devnet.yaml
# (${DEVNET_HELIUS_HTTP_URL}); the mainnet profile never reads this.
DEVNET_HELIUS_HTTP_URL=

# Research reads (config.rpc.enrichmentHttp): a SECOND Helius API key, so
# enrichment / cluster warm / shadow bursts can never 429 the trade key above
# (2026-10-03: research load + a second bot on one key starved buy confirms).
# Frankfurt: https://mainnet.helius-rpc.com/?api-key=<RESEARCH_KEY>
HELIUS_RESEARCH_HTTP_URL=

# Helius LaserStream gRPC (Yellowstone) for mainnet — covered on Business+.
# Frankfurt VM: https://laserstream-mainnet-fra.helius-rpc.com
# MUST EXIST, may stay empty: blank = the gRPC/LaserStream feeds self-skip.
# Fill both (token is usually the same API key) when the plan covers mainnet
# gRPC, flip detector.laserstreamEnabled to true in config.yaml, restart.
HELIUS_GRPC_URL=
HELIUS_GRPC_TOKEN=

# --- RPC read FAILOVER (config.rpc.fallbackHttp) ---
# 2026-10-04: config.yaml no longer reads these (fallbackHttp: [], no
# secondaryHttp) — an exhausted free-tier key only added 429s. Kept for
# profiles that still reference them.
# Do not run live on a single endpoint. When your only RPC is exhausted, every
# enrichment field degrades to `unknown`, and in live mode unknowns are vetoes —
# so a dead RPC looks like a bot that screens everything and trades nothing,
# rather than an outage. These are tried in order after the primary.
#
# Use a DIFFERENT provider from the primary: two keys on one provider share one
# quota and fail together, which defeats the point.
#
# Where to get one (all have a free tier, no card):
#   Alchemy   https://dashboard.alchemy.com  → Apps → New App → Solana → Mainnet
#   QuickNode https://dashboard.quicknode.com → Create endpoint → Solana → Mainnet
#   Ankr      https://www.ankr.com/rpc/solana → sign in → copy your keyed URL
# Paste the full HTTPS URL including any key/token it embeds.
#
# Blank is safe: empty slots are dropped, not errors. config.yaml also lists
# keyless public endpoints as a last resort behind these.
SECONDARY_HTTP_URL=
TERTIARY_HTTP_URL=

# --- Optional upgrades ---
# Devnet LaserStream endpoint + token (usually the same Helius API key).
# DEVNET_HELIUS_GRPC_URL=https://laserstream-devnet-ewr.helius-rpc.com
# (see config.devnet.yaml). Separate from the MAINNET HELIUS_GRPC_URL /
# HELIUS_GRPC_TOKEN above so the two profiles never share credentials.
DEVNET_HELIUS_GRPC_URL=
DEVNET_HELIUS_GRPC_TOKEN=
JITO_BLOCK_ENGINE_URL=
JITO_AUTH_TOKEN=
RUGCHECK_API_KEY=
# Decision model (decision.provider: jev) — TypeSafe Jev API key
TYPESAFE_API_KEY=
# Dashboard Basic Auth (config.dashboard.usernameEnvVar/passwordEnvVar).
# Both instances serve the dashboard (8787 mainnet / 8788 devnet) with
# auth OFF while these are blank; localhost-only bind keeps that safe.
# Set BOTH before ever binding the dashboard to a non-localhost host —
# the server refuses an exposed binding without them.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Shared secret Helius sends on webhook delivery (x-webhook-secret / Bearer).
HELIUS_WEBHOOK_SECRET=
